{
  "ideas": [
    {
      "id": 1,
      "name": "Crusher Alley",
      "approach": "handmade",
      "approachWhy": "The fun is a fair rhythm, and the open windows must be checked against walking speed by hand. Random beats easily make a stretch that is never open, so each variant is tuned and tested on its own.",
      "engine": {
        "have": [
          "slide motion on y (a slow up-and-down crusher)",
          "punch motion on any axis: shoots out fast, holds, slides back, rests (slam from above on y, wall punch on z)",
          "swing motion (pendulums, from BlobPendulums)",
          "per-part period and phase played at server time, so everyone sees the same beat",
          "puncher, gate and blob looks; NOT_FLOOR list so you can't stand on them",
          "flat floors and steps that climb, with step gap and rise tests"
        ],
        "new": [
          {
            "what": "hazard touch = back to the start pad (today punchers and pendulums shove you); one shared reset for every hazard idea (same piece ideas 8, 14 and 25 list)",
            "size": "S"
          },
          {
            "what": "red half-transparent hazard look for crusher, puncher and blob, plus a slam / thump sound",
            "size": "S"
          },
          {
            "what": "the tell: a floor shadow that grows as a crusher comes down, and a short wobble before it slams",
            "size": "S"
          },
          {
            "what": "'pattern' motion: a list of beats (full slam, half drop) instead of one even beat, for Fake Out; use the same beat-list format as Beat Pads' syncopated patterns (idea 18)",
            "size": "S"
          },
          {
            "what": "speed-up for Don't Dawdle and Hurry Up Hall: a per-player tempo ramp on top of the client beat clock from Beat Pads (idea 18); the beat gets faster while the local player waits at the entry or stays in the section; resets on a fall",
            "size": "M"
          },
          {
            "what": "fairness test: reuse the Collapsing Bridge runner (idea 24: 16 studs/s, 0.15 s lost per jump, 0.3 s per turn); every hazard must be open long enough for that runner with a margin, and every pocket between hazards must be safe at all times",
            "size": "S"
          },
          {
            "what": "one-shot trigger from Geyser Field (idea 21): stepping on a plate starts a short countdown, then the crusher above slams once and lifts, refills after a rest (for Trip Plate)",
            "size": "S"
          }
        ]
      },
      "readability": "Every crusher, puncher and swinging blob is red see-through goo, so you see the path behind it. A crusher's shadow grows on the floor and it wobbles before it slams, with a thump on impact; a puncher pulls back and glows before it shoots out.",
      "generator": null,
