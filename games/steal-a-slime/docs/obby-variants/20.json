{
 "ideas": [
  {
   "id": 20,
   "name": "Key Run",
   "approach": "mixed",
   "approachWhy": "Most of the fun is in where the islands are, so the base set is hand-made and hand-checked. A small generator then picks which spots on one fixed, pre-tested island map hold the keys: replay value without ever making an untested jump.",
   "engine": {
    "have": [
     "Step path with gap and rise tests (gap at most 6, rise at most 3.5 in ObbyCourse.spec)",
     "Look 'gate' (used by Goo Gates) and motion 'flip' to make a part solid or not",
     "Motion 'slide' (moving key pad, drifting key) and 'bounce' (spring pad for a high key)",
     "Hazard parts that send you back to the start pad; a fall sends you back too, which can also reset the keys",
     "Seeded random (Rng) for the generator",
     "Shared planned pieces this idea reuses instead of re-inventing: hazard touch = back to start (idea 1), route tags in the course tests (idea 11), BeatClock ticks (idea 18), Light-the-next trigger (idea 17), Darkness controller (idea 17), ride motion + moving-part gap check (idea 3), pad height rings (idea 4), section length cap ~100 (idea 8)"
    ],
    "new": [
     {
      "what": "Key pickup: a floating, sparkling key; touching it hides it, plays a chime and adds 1 to a client counter; all keys come back when you return to the start pad. Same piece Rising Goo (idea 12) reuses for its Drain Valve, so build it once with an 'on grab' event others can hook",
      "size": "M"
     },
     {
      "what": "Locked gate: a solid wall the full lane width, about 9 studs (same height as Sliding Maze's fixed walls, idea 25) so you can't jump over it; lock icons that fill in; opens with a clunk when full; can need fewer keys than exist (Spare Key)",
      "size": "S"
     },
     {
      "what": "Branch-aware tests: reuse Two Roads' (idea 11) route tags; key islands get route 'key', and the spec checks the jump out to each island and the jump back",
      "size": "S"
     },
     {
      "what": "Drift: on the key pickup's 'on grab' event the other keys start a slow upward slide and sink back after a set time",
      "size": "S"
     },
     {
      "what": "Countdown on the gate face, started by the first grab; ticks play through Beat Pads' BeatClock (idea 18); when it runs out the keys reset. Shares the per-player client timer with Two Roads' 'gate that shuts after you enter' (idea 11)",
      "size": "S"
     },
     {
      "what": "Ordered keys: only the next key glows and can be touched; built on Lights Out's Light-the-next trigger (idea 17), fired by a grab instead of a landing",
      "size": "S"
     },
     {
      "what": "Key Scatter generator: one fixed map of 8 tested island spots; the seed picks 2 to 4 of them",
      "size": "S"
     },
     {
      "what": "Optional anti-skip: the gate lives only on the client, so if skipping matters the client reports key grabs and the server checks the count before it counts the finish",
      "size": "M"
     }
    ]
   },
   "readability": "Keys float and sparkle and chime when grabbed; the gate is a dark wall with lock icons (0/3) that fill in, so you always know how many are left. A taken key leaves a faint outline. In the dark variant the keys carry their own glow, so they are the brightest things in the section.",
   "generator": {
    "inputs": "Course slot seed, the tier, and one fixed island map of 8 hand-tested spots (4 on each side of the path).",
    "randomises": "How many keys (2 to 4) and which spots hold them; on medium and hard, whether one key drifts.",
    "guarantees": "Every spot already passes the jump tests to and from the path; the total detour stays inside the tier's band; at least one key is in sight from the gate; a drifting key is never more than 25 studs from the path, so it can be reached in time.",
    "difficulty": "Easy: 2 to 3 keys on near spots (detour up to 35 studs). Medium: 3 keys, far spots allowed, one may drift. Hard: 4 keys, far spots with 5.5 stud gaps, one may drift."
   },
