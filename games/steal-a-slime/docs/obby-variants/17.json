{
  "ideas": [
    {
      "id": 17,
      "name": "Lights Out",
      "approach": "handmade",
      "approachWhy": "The fun is in how the light shows the way (slimes, pulses, a firefly, a sweeping beam), and each needs its own tuned layout so the next step can always be found. A random layout would too easily hide a jump in the dark, so the set is hand-made; only the platform zigzag could later be seeded.",
      "engine": {
        "have": [
          "Sections of step platforms with gap and rise checks (GAP_MAX 6, RISE_MAX 3.5 in ObbyCourse.spec)",
          "Motion kinds played on the client at server time: slide (moving platforms), spin (lighthouse arm), flip (on/off timing)",
          "Red see-through hazard goo and the back-to-start rule",
          "The course knows which section a runner is in (sectionAt), so the client can switch the dark on and off"
        ],
        "new": [
          {
            "what": "Darkness controller: the client fades Lighting (clock, brightness, ambient, fog) to night when you enter the section and back when you leave",
            "size": "M"
          },
          {
            "what": "Your soft light: a PointLight on your character, radius set per variant; can shrink over time and refill (Fading Lantern, Campfire Hop)",
            "size": "S"
          },
          {
            "what": "Glowing slime marker: a small Neon slime prop that sits on a safe platform",
            "size": "S"
          },
          {
            "what": "Glow-only motion (same piece as idea 10 Glow Memory): markers glow on a timer while the platform stays solid; the tick comes from the client beat clock (idea 18 Beat Pads)",
            "size": "S"
          },
          {
            "what": "Light-the-next trigger: landing on a platform switches on the marker of the next one(s); same landing hook as the melt trigger (idea 2)",
            "size": "S"
          },
          {
            "what": "Firefly guide: a client-only glowing bug that flies ahead along the step list and waits (or waits only a set time); can share code with idea 10's moving trail light (Trail Run)",
            "size": "M"
          },
          {
            "what": "Lighthouse beam: a SpotLight plus a see-through beam cone on a spinning arm (spin exists), platforms glow while the beam is on them",
            "size": "S"
          },
          {
            "what": "Lightning flash: full bright for a split second on a timer, with a thunder sound",
            "size": "S"
          }
        ]
      },
      "readability": "The whole section turns to night the moment you enter, with a soft night-hum sound; anything glowing green (a slime, an edge strip, a firefly) marks a safe place to land, and an orange campfire means your light fills up again. Hazards keep their red goo and glow dim red, so they never hide in the dark.",
