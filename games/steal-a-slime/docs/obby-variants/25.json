{
  "ideas": [
    {
      "id": 25,
      "name": "Sliding Maze",
      "approach": "mixed",
      "approachWhy": "A maze is the one idea where a generator really pays: a seeded maze gives a new route every course, and a timed solver can prove it is always passable. It shares the 3 x N grid and path search with Arrow Maze (idea 23); this idea adds time (walls that move). The special pieces (chaser wall, rewiring wall, plates, climbing maze) are easier to tune by hand, so those stay hand-made.",
      "engine": {
        "have": [
          "slide motion on any axis with period and phase, played at server time so every player sees the same walls",
          "flip motion (solid / see-through on a duty), for doors that blink instead of slide",
          "gate look and the Gate Run section: a goo wall on a slide beat, the closest thing to a sliding maze wall today",
          "seeded random (Rng) already used by the course builder, so a seeded maze is the same on every client",
          "flat floors and steps that climb, with the step rise tests"
        ],
        "new": [
          {
            "what": "hazard touch = back to the start pad: the shared piece from Crusher Alley (idea 1), not a second one",
            "size": "S"
          },
          {
            "what": "'shuttle' slide: hold, slide fast, hold (same name and code as Goo Rides idea 3 and Beat Pads' shuttle easing, idea 18; build once)",
            "size": "S"
          },
          {
            "what": "sliding walls use Arrow Maze's (idea 23) 'tall red curtain part' (9 studs, see-through, not jumpable), put on a shuttle slide",
            "size": "S"
          },
          {
            "what": "floor grooves (a dark strip or texture) under every sliding wall, showing exactly where it travels; no extra parts if it is a floor texture",
            "size": "S"
          },
          {
            "what": "fixed maze walls: a safe solid jelly wall look, about 9 studs tall so the maze can't be jumped over",
            "size": "S"
          },
          {
            "what": "tick half a second before a wall moves, hung on Beat Pads' BeatClock (idea 18), plus a soft 'shhk' slide sound",
            "size": "S"
          },
          {
            "what": "maze generator: extend Arrow Maze's (idea 23) grid builder and path search with time steps (cells x time), so one shared module serves both mazes; the walker uses Collapsing Bridge's runner numbers (idea 24: 16 studs/s, 0.15 s per jump, 0.3 s per turn)",
            "size": "M"
          },
          {
            "what": "chaser wall: starts sliding down the maze when you pass the start arch; the start uses Two Roads' per-player section clock (idea 11) and Rising Goo's start arch (idea 12), and resets at the start pad",
            "size": "M"
          },
          {
            "what": "pressure plate that opens one wall for a few seconds: Geyser Field's one-shot trigger (idea 21) driving a shuttle slide (Pull the Plug only)",
            "size": "S"
          }
        ]
      },
      "readability": "Red see-through walls are the only things that move and the only things that hurt; each one sits on a dark groove in the floor showing where it slides. Fixed walls are solid jelly and safe to touch, and a BeatClock tick plus a 'shhk' sound comes half a second before a wall moves.",
      "generator": {
        "inputs": "seed, tier, rows (5 to 12 cells along the course), 3 columns of 8 studs across the 24-stud lane, cell size 8 studs (the same grid as Arrow Maze, idea 23)",
        "randomises": "the maze itself (a seeded random spanning tree of the 3 x N grid), which passages get a sliding wall instead of an open gap, each wall's phase, how many dead ends are kept, and on hard whether a chaser wall is added",
        "guarantees": "a timed solver walks the maze with the shared runner (16 studs/s, 0.15 s per jump, 0.3 s per turn) and proves a route exists from any start moment, with at most one full beat of waiting; every open window is at least 1.5x the time to walk through it; walls only travel inside their groove at cell edges, so every cell centre is a safe place to stand and wait; nothing blocks the exit for longer than one beat; the exit flag is visible from the entry; at most 80 parts; if 50 seeds fail, fall back to a hand-made layout",
        "difficulty": "easy: 5 to 6 rows, all walls on one shared beat, open 1.5 s, no dead ends. Medium: 8 to 9 rows, two beats or each wall its own phase, open 1.0 s, 1 to 2 dead ends. Hard: 10 to 12 rows, each wall its own phase, open 0.7 s, 3 dead ends, maybe a chaser wall"
      },
