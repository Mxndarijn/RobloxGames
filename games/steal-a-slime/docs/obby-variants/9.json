{
  "ideas": [
    {
      "id": 9,
      "name": "Merry-go-round",
      "approach": "handmade",
      "approachWhy": "The fun comes from how the spins, arm speeds and disk sizes fit together, and a bad mix makes a jump you can never time. A few hand-tuned rides, each checked by a test at its line-up moment, beat a random mixer here. Spin phases can still shift a little per run, since all disks run on server time.",
      "engine": {
        "have": [
          "spin motion: turns a part round its vertical axis with AssemblyAngularVelocity, so a spinning disk carries the player (ObbyFx)",
          "Spinner builder: a 20-stud jelly disc, a centre post and red goo bars that spin at their own period and height",
          "disc shape, bar and post props, phase per part, negative period for the other direction",
          "rock motion (seesaw tip) and slide motion, used today on other pieces",
          "course tests: gap and rise checks at rest (GAP_MAX 6, RISE_MAX 3.5)"
        ],
        "new": [
          {
            "what": "Spin arrows round each disk's rim (yellow chevrons that scroll with the spin) plus a soft creak loop that speeds up with the spin",
            "size": "S"
          },
          {
            "what": "Hazard touch = back to the start pad (the shared one from idea 1; today Spinner bars shove you)",
            "size": "S"
          },
          {
            "what": "Reversing spin: speed follows a slow wave, so the disk slows, stops for a beat, then turns the other way. Uses the same warning as idea 23's 'turn' motion kind (1 s blink of the arrows + tick before the swap)",
            "size": "S"
          },
          {
            "what": "Spinning plank (propeller) platform: an 8-wide solid plank on a pivot",
            "size": "S"
          },
          {
            "what": "Moving-part gap check: reuse idea 3's 'test support' (closest gap between a moving ride and its dock or the next ride, not only at rest) for planks, seats and disk-to-disk line-ups",
            "size": "M"
          },
          {
            "what": "Wobble (spin plus tip on one part): reuse idea 15's 'a part that carries two motions at once'; check carry still works while it tips",
            "size": "M"
          },
          {
            "what": "Red goo slice riding on a disk (a hazard wedge welded to the floor, turning with it)",
            "size": "S"
          },
          {
            "what": "Orbit: small disks circling round a big centre post, like seats on a carousel",
            "size": "M"
          },
          {
            "what": "Wind Up: reuse idea 3's 'waits-for-you trigger' (client only) so a disk sits still until you step on, then its spin speeds up lap by lap",
            "size": "S"
          },
          {
            "what": "Spring Ride: reuse idea 4's 'Tilted pad' and 'Bounce on a moving pad', welded to a disk so the throw direction turns with it",
            "size": "S"
          },
          {
            "what": "Builder generalised from Spinner: a row of disks with size, height, spin, arms, slices and planks per disk, sized to 40-100 studs",
            "size": "M"
          }
        ]
      },
