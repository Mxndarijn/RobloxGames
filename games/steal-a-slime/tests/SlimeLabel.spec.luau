--!strict
-- Slime label values (contract/slime-labels.md): name, rarity, income, price, pad and growth,
-- and the income Scene hands to the label.
local Config = require("../src/shared/Config")
local Economy = require("../src/shared/Economy")
local Fixtures = require("./Fixtures")
local Perks = require("../src/shared/Perks")
local PlayerData = require("../src/shared/PlayerData")
local Scene = require("../src/server/Scene")
local ServerFixtures = require("./ServerFixtures")
local SlimeLabel = require("../src/shared/SlimeLabel")
local Spawner = require("../src/server/Spawner")
local TestRunner = require("./TestRunner")

local describe, it, expect = TestRunner.describe, TestRunner.it, TestRunner.expect
local T0 = ServerFixtures.T0

local function attrs(overrides: { [string]: any }?): SlimeLabel.Attributes
	local a: { [string]: any } = { name = "Lop", tier = 3, income = 1250 }
	for k, v in overrides or {} do
		a[k] = v
	end
	return a :: any
end

describe("SlimeLabel.incomeText", function()
	it("prefixes + and suffixes /s on the shared cash format", function()
		expect(SlimeLabel.incomeText(1250)).toBe("+$1.25K/s")
		expect(SlimeLabel.incomeText(12)).toBe("+$12/s")
		expect(SlimeLabel.incomeText(3.78)).toBe("+$3.7/s")
		expect(SlimeLabel.incomeText(0.88)).toBe("+$0.8/s")
		expect(SlimeLabel.incomeText(150.5)).toBe("+$150/s")
		expect(SlimeLabel.incomeText(2.5e6)).toBe("+$2.5M/s")
	end)
	it("shows +$0/s for garbage and negatives", function()
		expect(SlimeLabel.incomeText(nil)).toBe("+$0/s")
		expect(SlimeLabel.incomeText(0 / 0)).toBe("+$0/s")
		expect(SlimeLabel.incomeText(-5)).toBe("+$0/s")
		expect(SlimeLabel.incomeText("12")).toBe("+$0/s")
	end)
	it("reports a change only when the shown text changes", function()
		expect(SlimeLabel.incomeChanged(nil, 5)).toBe(true)
		expect(SlimeLabel.incomeChanged(1250, 1251)).toBe(false)
		expect(SlimeLabel.incomeChanged(1250, 1260)).toBe(true)
		expect(SlimeLabel.incomeChanged(12.11, 12.19)).toBe(false)
		expect(SlimeLabel.incomeChanged(0.81, 0.92)).toBe(true)
	end)
end)

describe("SlimeLabel.priceText", function()
	it("shows the price of a priced wild slime", function()
		expect(SlimeLabel.priceText(500)).toBe("$500")
		expect(SlimeLabel.priceText(25000)).toBe("$25K")
	end)
	it("shows nothing for a free slime or garbage", function()
		expect(SlimeLabel.priceText(0)).toBeNil()
		expect(SlimeLabel.priceText(nil)).toBeNil()
		expect(SlimeLabel.priceText(0 / 0)).toBeNil()
	end)
end)

describe("SlimeLabel.view", function()
	it("names the species with its rarity, tier and income", function()
		local v = assert(SlimeLabel.view(attrs()))
		expect(v.name).toBe("Lop")
		expect(v.rarity).toBe(Config.RARITIES[3].name)
		expect(v.tier).toBe(3)
		expect(v.rarityColor).toBe(Config.RARITIES[3].color)
		expect(v.income).toBe("+$1.25K/s")
		expect(v.price).toBeNil()
		expect(v.growth).toBe(0)
		expect(v.pad).toBeNil()
		expect(SlimeLabel.rows(v)).toBe(3)
	end)
	it("adds the price row", function()
		local v = assert(SlimeLabel.view(attrs({ price = 900 })))
		expect(v.price).toBe("$900")
		expect(SlimeLabel.rows(v)).toBe(4)
	end)
	it("gives a boss its prefix and no income row", function()
		local v = assert(SlimeLabel.view(attrs({ boss = true })))
		expect(v.name).toBe("BOSS Lop")
		expect(v.income).toBeNil()
		expect(SlimeLabel.rows(v)).toBe(2)
	end)
	it("carries the pad and the whole growth percent of a pad slime", function()
		local v = assert(SlimeLabel.view(attrs({ pad = 3, growth = 46 })))
		expect(v.pad).toBe(3)
		expect(v.growth).toBe(46)
		expect(assert(SlimeLabel.view(attrs({ pad = 0, growth = 150 }))).pad).toBeNil()
		expect(assert(SlimeLabel.view(attrs({ growth = 150 }))).growth).toBe(100)
		expect(assert(SlimeLabel.view(attrs({ growth = "x" }))).growth).toBe(0)
	end)
	it("clamps a garbage tier and returns nil without a name", function()
		expect(assert(SlimeLabel.view(attrs({ tier = 99 }))).rarity).toBe(Config.RARITIES[Config.MAX_TIER].name)
		expect(assert(SlimeLabel.view(attrs({ tier = "x" }))).rarity).toBe(Config.RARITIES[1].name)
		expect(SlimeLabel.view(attrs({ name = "" }))).toBeNil()
		expect(SlimeLabel.view(attrs({ name = 5 }))).toBeNil()
	end)
	it("carries the shine row of the Shine attribute, for the tag's pill", function()
		for _, row in Config.SHINES do
			local v = assert(SlimeLabel.view(attrs({ shine = row.id })))
			expect(v.shine).toBe(row)
			expect(v.name).toBe("Lop")
			expect(SlimeLabel.rows(v)).toBe(3)
		end
		expect(assert(SlimeLabel.view(attrs())).shine).toBeNil()
		expect(assert(SlimeLabel.view(attrs({ shine = "Mud" }))).shine).toBeNil()
		expect(assert(SlimeLabel.view(attrs({ shine = 7 }))).shine).toBeNil()
	end)
end)

describe("SlimeLabel wild income with the viewer's bonuses", function()
	it("multiplies a wild slime's income by the viewer's multiplier", function()
		expect(assert(SlimeLabel.view(attrs({ income = 100 }), 2.5)).income).toBe("+$250/s")
		expect(assert(SlimeLabel.view(attrs({ income = 100, owner = 0 }), 3)).income).toBe("+$300/s")
	end)
	it("shows an owned slime's income as is: it already counts its owner's bonuses", function()
		expect(assert(SlimeLabel.view(attrs({ income = 100, owner = 7 }), 3)).income).toBe("+$100/s")
		expect(assert(SlimeLabel.view(attrs({ income = 100, owner = 7, pad = 2 }), 3)).income).toBe("+$100/s")
	end)
	it("treats a missing or bad multiplier as 1", function()
		expect(assert(SlimeLabel.view(attrs({ income = 100 }))).income).toBe("+$100/s")
		expect(assert(SlimeLabel.view(attrs({ income = 100 }), 0 / 0)).income).toBe("+$100/s")
		expect(assert(SlimeLabel.view(attrs({ income = 100 }), -2)).income).toBe("+$100/s")
	end)
	it("keeps a boss without an income row", function()
		expect(assert(SlimeLabel.view(attrs({ boss = true }), 4)).income).toBeNil()
	end)
	it("shows what the slime would earn on the viewer's pad", function()
		local world = ServerFixtures.world()
		local session = ServerFixtures.join(world, 1, {})
		session.data.rebirths = 3
		session.data.friendBonus = 0.2
		session.data.boostMult = 2
		local id = Spawner.spawnOne(world, T0)
		local slime = world.wild[id].slime
		local shown = SlimeLabel.shownIncome(
			{ income = Scene.describe(world, T0)[id].income } :: any,
			Perks.incomeMultiplier(session.data)
		)
		expect(math.abs(shown - PlayerData.slimeIncome(session.data, slime)) < 1e-6 * shown).toBe(true)
		expect(shown > Economy.slimeIncome(slime, 0)).toBe(true)
	end)
end)

describe("SlimeLabel.attributes", function()
	it("writes the species name and tier", function()
		local name, tier = SlimeLabel.attributes(Fixtures.slime("a", 4))
		expect(name).toBe("Blorp")
		expect(tier).toBe(4)
	end)
end)

describe("Scene income for the label", function()
	it("pad slimes earn with the owner's rebirths, like State SlimeView.income", function()
		local world = ServerFixtures.world()
		local slime = Fixtures.slime("a", 3, { size = 1.5 })
		local session = ServerFixtures.join(world, 1, { slime })
		session.data.rebirths = 2
		local e = Scene.describe(world, T0)["a"]
		expect(e.income).toBe(PlayerData.slimeIncome(session.data, session.data.slimes[1]))
		expect(e.income > Economy.slimeIncome(session.data.slimes[1], 0)).toBe(true)
	end)
	it("wild slimes show their income without rebirths", function()
		local world = ServerFixtures.world()
		local id = Spawner.spawnOne(world, T0)
		local e = Scene.describe(world, T0)[id]
		expect(e.income).toBe(Economy.slimeIncome(world.wild[id].slime, 0))
	end)
end)
