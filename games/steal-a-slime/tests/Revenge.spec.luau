--!strict
local Carry = require("../src/server/Carry")
local Config = require("../src/shared/Config")
local Economy = require("../src/shared/Economy")
local Fixtures = require("./Fixtures")
local PlotPrompts = require("../src/server/PlotPrompts")
local Revenge = require("../src/server/Revenge")
local RevengePlots = require("../src/shared/RevengePlots")
local ServerFixtures = require("./ServerFixtures")
local Sessions = require("../src/server/Sessions")
local Snapshot = require("../src/server/Snapshot")
local StealService = require("../src/server/StealService")
local TestRunner = require("./TestRunner")
local World = require("../src/server/World")

local describe, it, expect = TestRunner.describe, TestRunner.it, TestRunner.expect
local T0 = ServerFixtures.T0
local WINDOW = Config.REVENGE_SECONDS
local LATER = T0 + 1000 -- join locks long gone

-- Victim `1` and `3` each own a slime; thief is `2`. Everyone's join lock is lifted.
local function setup()
	local world = ServerFixtures.world()
	local v1 = ServerFixtures.join(world, 1, { Fixtures.slime("gem1", 4), Fixtures.slime("gem1b", 4) })
	local thief = ServerFixtures.join(world, 2)
	local v3 = ServerFixtures.join(world, 3, { Fixtures.slime("gem3", 4) })
	for _, s in { v1, thief, v3 } do
		ServerFixtures.unlock(s)
	end
	return world, v1, thief, v3
end

local function rob(world: World.World, thiefId: number, slimeId: string, now: number)
	expect((Carry.grab(world, thiefId, slimeId, 1, now))).toBe(true)
	expect((Carry.deposit(world, thiefId, now))).toBe(true)
end

-- What the thief's lock costs right now, by every route the player can see.
local function lockCosts(world: World.World, thief: World.Session, now: number): (number, number, number)
	local state = Snapshot.build(world, thief, now)
	local plotCost = PlotPrompts.describe(world, thief.plotIndex, now).lockCost
	local base = Economy.lockCost(World.incomeOf(world, thief))
	return state.lockCost, plotCost, base
end

describe("Revenge window", function()
	it("opens for the victim only when the steal is completed", function()
		local world, victim, thief = setup()
		Carry.grab(world, 2, "gem1", 1, LATER)
		expect(Revenge.isActive(world, 1, 2, LATER)).toBe(false) -- carrying is not robbing yet
		Carry.deposit(world, 2, LATER)
		expect(Revenge.isActive(world, 1, 2, LATER)).toBe(true)
		expect(Revenge.isActive(world, 2, 1, LATER)).toBe(false)
		expect(Revenge.plotsFor(world, 1, LATER)[1]).toBe(thief.plotIndex)
		expect(#Revenge.plotsFor(world, 2, LATER)).toBe(0) -- the thief sees nothing
		expect(#Revenge.plotsFor(world, 3, LATER)).toBe(0) -- bystanders neither
		expect(victim.userId).toBe(1)
	end)
	it("an escaped slime opens no window", function()
		local world = setup()
		Carry.grab(world, 2, "gem1", 1, LATER)
		StealService.escape(world, World.session(world, 2) :: World.Session, LATER + 1, "wriggle")
		expect(Revenge.isActive(world, 1, 2, LATER + 1)).toBe(false)
	end)
	it("a deposit without a clock opens no window", function()
		local world = setup()
		Carry.grab(world, 2, "gem1", 1, LATER)
		Carry.deposit(world, 2)
		expect(Revenge.isActive(world, 1, 2, LATER)).toBe(false)
	end)
	it("expires exactly at REVENGE_SECONDS", function()
		local world = setup()
		rob(world, 2, "gem1", LATER)
		expect(Revenge.isActive(world, 1, 2, LATER + WINDOW - 0.01)).toBe(true)
		expect(#Revenge.plotsFor(world, 1, LATER + WINDOW - 0.01)).toBe(1)
		expect(Revenge.isActive(world, 1, 2, LATER + WINDOW)).toBe(false)
		expect(#Revenge.plotsFor(world, 1, LATER + WINDOW)).toBe(0)
	end)
	it("prune drops expired marks and pushes State to the thief", function()
		local world, _, thief = setup()
		rob(world, 2, "gem1", LATER)
		thief.locked = false -- lock state already settled, so only Revenge can dirty the thief
		thief.dirty = false
		StealService.step(world, LATER + WINDOW - 1)
		expect(world.revenge[1]).toBeTruthy()
		expect(thief.dirty).toBe(false)
		StealService.step(world, LATER + WINDOW)
		expect(world.revenge[1]).toBeNil()
		expect(thief.dirty).toBe(true)
	end)
	it("robbing the same victim again refreshes the window instead of stacking", function()
		local world = setup()
		rob(world, 2, "gem1", LATER)
		rob(world, 2, "gem1b", LATER + 30)
		expect(Revenge.isActive(world, 1, 2, LATER + WINDOW + 20)).toBe(true) -- 30 + 60 from the second theft
		expect(Revenge.isActive(world, 1, 2, LATER + 30 + WINDOW)).toBe(false)
		expect(Revenge.lockMultiplier(world, 2, LATER + 30)).toBe(Config.REVENGE_LOCK_COST_MULT)
	end)
end)

describe("Revenge lock cost", function()
	it("doubles the thief's lock cost in State, the plot attribute and the purchase", function()
		local world, victim, thief = setup()
		thief.data.cash = 1e9
		local stateBefore, plotBefore, base = lockCosts(world, thief, LATER)
		expect(stateBefore).toBe(base)
		expect(plotBefore).toBe(base)
		rob(world, 2, "gem1", LATER)
		local state, plot = lockCosts(world, thief, LATER)
		local doubled = Economy.lockCost(World.incomeOf(world, thief)) * 2
		expect(state).toBe(doubled)
		expect(plot).toBe(doubled)
		local cash = thief.data.cash
		expect((StealService.buyLock(world, thief, LATER))).toBe(true)
		expect(cash - thief.data.cash).toBe(doubled)
		expect(victim.data.cash >= 0).toBe(true)
	end)
	it("the victim and bystanders keep paying the normal price", function()
		local world, victim, _, other = setup()
		rob(world, 2, "gem1", LATER)
		for _, s in { victim, other } do
			local state, plot, base = lockCosts(world, s, LATER)
			expect(state).toBe(base)
			expect(plot).toBe(base)
			expect(Revenge.lockMultiplier(world, s.userId, LATER)).toBe(1)
		end
	end)
	it("is back to normal once the window ends", function()
		local world, _, thief = setup()
		rob(world, 2, "gem1", LATER)
		thief.data.cash = 1e9
		local state, _, base = lockCosts(world, thief, LATER + WINDOW)
		expect(state).toBe(base)
		local cash = thief.data.cash
		expect((StealService.buyLock(world, thief, LATER + WINDOW))).toBe(true)
		expect(cash - thief.data.cash).toBe(base)
	end)
end)

describe("Revenge several thieves and victims", function()
	it("one thief robbing two victims pays x2 (not x4) until both windows end", function()
		local world, _, thief = setup()
		rob(world, 2, "gem1", LATER)
		rob(world, 2, "gem3", LATER + 40)
		expect(Revenge.lockMultiplier(world, 2, LATER + 50)).toBe(2)
		expect(Revenge.lockMultiplier(world, 2, LATER + WINDOW)).toBe(2) -- victim 3's window runs to +100
		expect(Revenge.lockMultiplier(world, 2, LATER + 40 + WINDOW)).toBe(1)
		expect(thief.userId).toBe(2)
	end)
	it("each victim sees only their own thieves, and two thieves show both plots", function()
		local world, _, thief, v3 = setup()
		local thief4 = ServerFixtures.join(world, 4)
		ServerFixtures.unlock(thief4)
		rob(world, 2, "gem1", LATER)
		rob(world, 4, "gem3", LATER + 5)
		local plots1 = Revenge.plotsFor(world, 1, LATER + 6)
		local plots3 = Revenge.plotsFor(world, 3, LATER + 6)
		expect(#plots1).toBe(1)
		expect(plots1[1]).toBe(thief.plotIndex)
		expect(#plots3).toBe(1)
		expect(plots3[1]).toBe(thief4.plotIndex)
		-- victim 1 robbed again by thief 4: now sees both, sorted
		Revenge.mark(world, 1, 4, LATER + 6)
		local both = Revenge.plotsFor(world, 1, LATER + 7)
		expect(#both).toBe(2)
		expect(both[1] < both[2]).toBe(true)
		expect(v3.userId).toBe(3)
	end)
	it("windows end independently", function()
		local world = setup()
		local thief4 = ServerFixtures.join(world, 4)
		ServerFixtures.unlock(thief4)
		rob(world, 2, "gem1", LATER)
		rob(world, 4, "gem3", LATER + 30)
		expect(Revenge.lockMultiplier(world, 2, LATER + WINDOW)).toBe(1)
		expect(Revenge.lockMultiplier(world, 4, LATER + WINDOW)).toBe(2)
	end)
end)

describe("Revenge thief or victim leaving", function()
	it("thief leaving removes the highlight and the mark", function()
		local world = setup()
		rob(world, 2, "gem1", LATER)
		Sessions.leave(world, 2, LATER + 5)
		expect(#Revenge.plotsFor(world, 1, LATER + 5)).toBe(0)
		expect(world.revenge[1]).toBeNil()
	end)
	it("a rejoining thief starts clean", function()
		local world = setup()
		rob(world, 2, "gem1", LATER)
		Sessions.leave(world, 2, LATER + 5)
		local back = ServerFixtures.join(world, 2, nil, nil, LATER + 10)
		expect(Revenge.lockMultiplier(world, 2, LATER + 10)).toBe(1)
		expect(#Revenge.plotsFor(world, 1, LATER + 10)).toBe(0)
		expect(back.userId).toBe(2)
	end)
	it("victim leaving ends the thief's x2 and pushes State", function()
		local world, _, thief = setup()
		rob(world, 2, "gem1", LATER)
		thief.dirty = false
		Sessions.leave(world, 1, LATER + 5)
		expect(Revenge.lockMultiplier(world, 2, LATER + 5)).toBe(1)
		expect(thief.dirty).toBe(true)
	end)
	it("one victim leaving leaves the other victim's window on the thief", function()
		local world = setup()
		rob(world, 2, "gem1", LATER)
		rob(world, 2, "gem3", LATER + 1)
		Sessions.leave(world, 1, LATER + 5)
		expect(Revenge.lockMultiplier(world, 2, LATER + 5)).toBe(2)
	end)
	it("plotsFor skips a thief who is no longer in the server even before forget", function()
		local world = setup()
		Revenge.mark(world, 1, 99, LATER)
		expect(#Revenge.plotsFor(world, 1, LATER)).toBe(0)
	end)
end)

describe("RevengePlots wire format", function()
	it("round-trips plot indexes and treats empty as nil", function()
		expect(RevengePlots.format({})).toBeNil()
		expect(RevengePlots.format({ 3 })).toBe("3")
		expect(RevengePlots.format({ 3, 5 })).toBe("3,5")
		local back = RevengePlots.parse("3,5")
		expect(#back).toBe(2)
		expect(back[1]).toBe(3)
		expect(back[2]).toBe(5)
	end)
	it("parse ignores junk, duplicates and non-strings", function()
		expect(#RevengePlots.parse(nil)).toBe(0)
		expect(#RevengePlots.parse(7)).toBe(0)
		expect(#RevengePlots.parse("")).toBe(0)
		expect(#RevengePlots.parse("a,0,-2,1.5,,4,4")).toBe(1)
		expect(RevengePlots.parse("a,0,-2,1.5,,4,4")[1]).toBe(4)
	end)
end)
