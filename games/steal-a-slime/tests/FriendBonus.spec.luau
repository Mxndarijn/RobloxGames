--!strict
-- Friend income bonus: math, cap, caching, failure fallback, income + State (CONTRACT.md §11).
local Config = require("../src/shared/Config")
local Fixtures = require("./Fixtures")
local FriendBonus = require("../src/shared/FriendBonus")
local Friends = require("../src/server/Friends")
local Income = require("../src/server/Income")
local Perks = require("../src/shared/Perks")
local PlayerData = require("../src/shared/PlayerData")
local ServerFixtures = require("./ServerFixtures")
local Sessions = require("../src/server/Sessions")
local Snapshot = require("../src/server/Snapshot")
local TestRunner = require("./TestRunner")

local describe, it, expect = TestRunner.describe, TestRunner.it, TestRunner.expect
local T0 = ServerFixtures.T0

-- A friend graph as a pair set; counts the calls.
local function graph(pairs_: { { number } })
	local set: { [string]: boolean } = {}
	for _, p in pairs_ do
		set[`{math.min(p[1], p[2])}:{math.max(p[1], p[2])}`] = true
	end
	local state = { calls = 0, fail = false }
	local cache = Friends.new(function(a: number, b: number): boolean
		state.calls += 1
		if state.fail then
			error("HTTP 429")
		end
		return set[`{math.min(a, b)}:{math.max(a, b)}`] == true
	end)
	return cache, state
end

describe("FriendBonus math", function()
	it("is +10% per friend", function()
		expect(FriendBonus.bonus(0)).toBe(0)
		expect(FriendBonus.bonus(1)).toBeCloseTo(0.1)
		expect(FriendBonus.bonus(2)).toBeCloseTo(0.2)
		expect(FriendBonus.multiplier(2)).toBeCloseTo(1.2)
	end)
	it("caps at +30%", function()
		expect(FriendBonus.bonus(3)).toBe(Config.FRIEND_BONUS_CAP)
		expect(FriendBonus.bonus(4)).toBe(Config.FRIEND_BONUS_CAP)
		expect(FriendBonus.bonus(100)).toBe(Config.FRIEND_BONUS_CAP)
		expect(FriendBonus.maxFriends()).toBe(3)
	end)
	it("ignores nonsense counts", function()
		expect(FriendBonus.bonus(-2)).toBe(0)
		expect(FriendBonus.bonus(0 / 0)).toBe(0)
	end)
end)

describe("Friends.refresh", function()
	it("counts friends in the same server and sets data.friendBonus", function()
		local world = ServerFixtures.world()
		local a = ServerFixtures.join(world, 1, nil, 0)
		local b = ServerFixtures.join(world, 2, nil, 0)
		local c = ServerFixtures.join(world, 3, nil, 0)
		local cache = graph({ { 1, 2 }, { 1, 3 } })
		Friends.refresh(cache, world, T0)
		expect(a.friends).toBe(2)
		expect(a.data.friendBonus).toBeCloseTo(0.2)
		expect(b.friends).toBe(1)
		expect(b.data.friendBonus).toBeCloseTo(0.1)
		expect(c.friends).toBe(1)
	end)
	it("a stranger gets no bonus (and no field)", function()
		local world = ServerFixtures.world()
		local a = ServerFixtures.join(world, 1, nil, 0)
		ServerFixtures.join(world, 2, nil, 0)
		Friends.refresh(graph({}), world, T0)
		expect(a.friends).toBe(0)
		expect(a.data.friendBonus).toBeNil()
	end)
	it("caps at three friends", function()
		local world = ServerFixtures.world()
		local host = ServerFixtures.join(world, 1, nil, 0)
		local links = {}
		for id = 2, 6 do
			ServerFixtures.join(world, id, nil, 0)
			table.insert(links, { 1, id })
		end
		Friends.refresh(graph(links), world, T0)
		expect(host.friends).toBe(5)
		expect(host.data.friendBonus).toBe(Config.FRIEND_BONUS_CAP)
	end)
	it("recalculates on join and leave", function()
		local world = ServerFixtures.world()
		local a = ServerFixtures.join(world, 1, nil, 0)
		local cache = graph({ { 1, 2 } })
		Friends.refresh(cache, world, T0)
		expect(a.data.friendBonus).toBeNil()
		ServerFixtures.join(world, 2, nil, 0)
		local changed = Friends.refresh(cache, world, T0 + 1)
		expect(a.data.friendBonus).toBeCloseTo(0.1)
		expect(#changed).toBe(2)
		expect(a.dirty).toBe(true)
		Sessions.leave(world, 2, T0 + 2)
		Friends.forget(cache, 2)
		Friends.refresh(cache, world, T0 + 2)
		expect(a.friends).toBe(0)
		expect(a.data.friendBonus).toBeNil()
	end)
end)

describe("Friends caching", function()
	it("asks once per pair inside the cache window", function()
		local world = ServerFixtures.world()
		ServerFixtures.join(world, 1, nil, 0)
		ServerFixtures.join(world, 2, nil, 0)
		local cache, state = graph({ { 1, 2 } })
		Friends.refresh(cache, world, T0)
		Friends.refresh(cache, world, T0 + 10)
		Friends.refresh(cache, world, T0 + Config.FRIEND_CACHE_SECONDS - 1)
		expect(state.calls).toBe(1)
		Friends.refresh(cache, world, T0 + Config.FRIEND_CACHE_SECONDS + 1)
		expect(state.calls).toBe(2)
	end)
	it("asks about a newcomer's pairs only", function()
		local world = ServerFixtures.world()
		ServerFixtures.join(world, 1, nil, 0)
		ServerFixtures.join(world, 2, nil, 0)
		local cache, state = graph({})
		Friends.refresh(cache, world, T0)
		expect(state.calls).toBe(1)
		ServerFixtures.join(world, 3, nil, 0)
		Friends.refresh(cache, world, T0 + 1)
		expect(state.calls).toBe(3) -- 1-3 and 2-3
	end)
	it("forget drops only the leaver's pairs", function()
		local cache, state = graph({ { 1, 2 }, { 2, 3 } })
		Friends.areFriends(cache, 1, 2, T0)
		Friends.areFriends(cache, 2, 3, T0)
		Friends.areFriends(cache, 1, 3, T0)
		Friends.forget(cache, 2)
		expect(Friends.cached(cache, 1, 2)).toBe(false)
		Friends.areFriends(cache, 1, 3, T0 + 1)
		expect(state.calls).toBe(3)
		Friends.areFriends(cache, 1, 2, T0 + 1)
		expect(state.calls).toBe(4)
		expect(Friends.cached(cache, 2, 12)).toBe(false)
	end)
end)

describe("Friends failure fallback", function()
	it("a throwing check counts as not friends and never throws", function()
		local world = ServerFixtures.world()
		local a = ServerFixtures.join(world, 1, nil, 0)
		ServerFixtures.join(world, 2, nil, 0)
		local cache, state = graph({ { 1, 2 } })
		state.fail = true
		Friends.refresh(cache, world, T0)
		expect(a.friends).toBe(0)
		expect(a.data.friendBonus).toBeNil()
	end)
	it("doesn't hammer a failing service, then retries", function()
		local cache, state = graph({ { 1, 2 } })
		state.fail = true
		Friends.areFriends(cache, 1, 2, T0)
		Friends.areFriends(cache, 1, 2, T0 + 5)
		expect(state.calls).toBe(1)
		state.fail = false
		expect(Friends.areFriends(cache, 1, 2, T0 + Config.FRIEND_RETRY_SECONDS + 1)).toBe(true)
		expect(state.calls).toBe(2)
	end)
	it("keeps the last known answer when a refresh later fails", function()
		local cache, state = graph({ { 1, 2 } })
		expect(Friends.areFriends(cache, 1, 2, T0)).toBe(true)
		state.fail = true
		expect(Friends.areFriends(cache, 1, 2, T0 + Config.FRIEND_CACHE_SECONDS + 1)).toBe(true)
	end)
end)

describe("friend bonus in income and State", function()
	it("goes through Perks.bonusMultiplier / incomePerSecond", function()
		local data = Fixtures.data({ Fixtures.slime("a", 2) }, 0)
		local base = PlayerData.incomePerSecond(data)
		data.friendBonus = 0.2
		expect(PlayerData.incomePerSecond(data)).toBeCloseTo(base * 1.2)
		expect(Perks.incomeMultiplier(data)).toBeCloseTo(Perks.incomeMultiplier(Fixtures.data()) * 1.2)
	end)
	it("stacks multiplicatively with the code boost", function()
		local data = Fixtures.data({ Fixtures.slime("a", 2) }, 0)
		local base = PlayerData.incomePerSecond(data)
		data.boostMult, data.friendBonus = 2, 0.3
		expect(PlayerData.incomePerSecond(data)).toBeCloseTo(base * 2 * 1.3)
	end)
	it("Income.step pays the bonus", function()
		local world = ServerFixtures.world()
		local s = ServerFixtures.join(world, 1, { Fixtures.slime("a", 3) }, 0)
		local base = PlayerData.incomePerSecond(s.data)
		s.data.friendBonus = 0.3
		Income.step(world, 1)
		expect(s.data.cash).toBe(math.floor(base * 1.3))
	end)
	it("State.friends carries count and bonus", function()
		local world = ServerFixtures.world()
		local a = ServerFixtures.join(world, 1, nil, 0)
		ServerFixtures.join(world, 2, nil, 0)
		expect(Snapshot.build(world, a, T0).friends.count).toBe(0)
		Friends.refresh(graph({ { 1, 2 } }), world, T0)
		local state = Snapshot.build(world, a, T0)
		expect(state.friends.count).toBe(1)
		expect(state.friends.bonus).toBeCloseTo(0.1)
	end)
	it("is never saved", function()
		local SaveData = require("../src/shared/SaveData")
		local data = Fixtures.data({}, 0)
		data.friendBonus = 0.3
		local back = SaveData.deserialize(SaveData.serialize(data, T0), T0)
		expect(back.friendBonus).toBeNil()
	end)
end)
