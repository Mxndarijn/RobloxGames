--!strict
local Carry = require("../src/server/Carry")
local Config = require("../src/shared/Config")
local DataService = require("../src/server/DataService")
local Fixtures = require("./Fixtures")
local GameLoop = require("../src/server/GameLoop")
local PlayerData = require("../src/shared/PlayerData")
local ServerFixtures = require("./ServerFixtures")
local StealService = require("../src/server/StealService")
local TestRunner = require("./TestRunner")
local World = require("../src/server/World")

local describe, it, expect = TestRunner.describe, TestRunner.it, TestRunner.expect
local T0 = ServerFixtures.T0

-- Victim 1 owns "gem" (Epic); thief 2 stands next to it.
local function setup()
	local world = ServerFixtures.world()
	local victim = ServerFixtures.join(world, 1, { Fixtures.slime("gem", 4) })
	local thief = ServerFixtures.join(world, 2)
	return world, victim, thief
end

describe("StealService lock", function()
	it("locks every plot for JOIN_LOCK_SECONDS on join", function()
		local world, victim = setup()
		expect(victim.lockUntil).toBe(T0 + Config.JOIN_LOCK_SECONDS)
		expect(StealService.isLocked(victim, T0 + Config.JOIN_LOCK_SECONDS - 1)).toBe(true)
		expect(StealService.isLocked(victim, T0 + Config.JOIN_LOCK_SECONDS)).toBe(false)
		expect(select(2, Carry.grab(world, 2, "gem", 1, T0 + 1))).toBe("base is locked")
	end)
	it("buyLock is free and gives the full rebirth-scaled duration in one go", function()
		local world, victim = setup()
		victim.data.cash = 0
		victim.data.rebirths = 2
		local now = T0 + Config.JOIN_LOCK_SECONDS + 10 -- join lock expired
		expect((StealService.buyLock(world, victim, now))).toBe(true)
		expect(victim.lockUntil).toBe(now + Config.LOCK_SECONDS + 2 * Config.LOCK_SECONDS_PER_REBIRTH)
		expect(victim.data.cash).toBe(0)
	end)
	it("buyLock refuses while locked: lockUntil, start and stats stay", function()
		local world, victim = setup()
		local before, started, locks = victim.lockUntil, victim.lockStartedAt, victim.data.stats.locks
		local ok, reason = StealService.buyLock(world, victim, T0 + 10)
		expect(ok).toBe(false)
		expect(reason).toBe("your base is already locked")
		expect(victim.lockUntil).toBe(before)
		expect(victim.lockStartedAt).toBe(started)
		expect(victim.data.stats.locks).toBe(locks)
	end)
	it("buyLock works again after expiry and gives the full time again", function()
		local world, victim = setup()
		local t1 = T0 + Config.JOIN_LOCK_SECONDS
		expect((StealService.buyLock(world, victim, t1))).toBe(true)
		expect(victim.lockUntil).toBe(t1 + Config.LOCK_SECONDS)
		expect((StealService.buyLock(world, victim, t1 + 1))).toBe(false)
		local t2 = victim.lockUntil
		expect((StealService.buyLock(world, victim, t2))).toBe(true)
		expect(victim.lockUntil).toBe(t2 + Config.LOCK_SECONDS)
		expect(victim.lockStartedAt).toBe(t2)
	end)
	it("step notices lock expiry once and pushes State", function()
		local world, victim = setup()
		victim.dirty = false
		StealService.step(world, T0 + Config.JOIN_LOCK_SECONDS)
		expect(victim.locked).toBe(false)
		expect(victim.dirty).toBe(true)
		expect(#ServerFixtures.notifications(world, 1)).toBe(1)
		StealService.step(world, T0 + Config.JOIN_LOCK_SECONDS + 1)
		expect(#ServerFixtures.notifications(world, 1)).toBe(1)
	end)
end)

describe("StealService.steal", function()
	it("starts a stolen carry with no time limit and pings the owner", function()
		local world, victim, thief = setup()
		ServerFixtures.unlock(victim)
		expect((Carry.grab(world, 2, "gem", 3, T0))).toBe(true)
		local carry = thief.carry
		assert(carry, "carry")
		expect(carry.kind).toBe("stolen")
		expect(carry.ownerUserId).toBe(1)
		expect((carry.timer :: any).escapeAt).toBeNil()
		expect(world.carriedBy.gem).toBe(2)
		expect(#ServerFixtures.notifications(world, 1)).toBe(1)
		local alarm = world.outbox[1]
		expect(alarm.kind).toBe("bad")
	end)
	it("a slime being carried pays its owner nothing", function()
		local world, victim = setup()
		ServerFixtures.unlock(victim)
		local before = World.incomeOf(world, victim)
		Carry.grab(world, 2, "gem", 3, T0)
		expect(before > 0).toBeTruthy()
		expect(World.incomeOf(world, victim)).toBe(0)
	end)
	it("refuses own slimes, far thieves and busy slimes", function()
		local world, victim = setup()
		ServerFixtures.unlock(victim)
		expect(select(2, Carry.grab(world, 1, "gem", 1, T0))).toBe("that's your own slime")
		expect(select(2, Carry.grab(world, 2, "gem", Config.STEAL_REACH + 1, T0))).toBe("too far away")
		world.escaping.gem = T0 + 1
		expect(select(2, Carry.grab(world, 2, "gem", 1, T0))).toBe("someone is already carrying it")
	end)
	it("deposit at the thief's home moves the slime and counts the steal", function()
		local world, victim, thief = setup()
		ServerFixtures.unlock(victim)
		Carry.grab(world, 2, "gem", 1, T0)
		expect((Carry.deposit(world, 2))).toBe(true)
		expect(PlayerData.findSlime(victim.data, "gem")).toBeNil()
		local slime = PlayerData.findSlime(thief.data, "gem")
		expect(slime and slime.pad).toBe(1)
		expect(thief.data.totalStolen).toBe(1)
		expect(world.carriedBy.gem).toBeNil()
		expect(thief.carry).toBeNil()
	end)
end)

describe("StealService pet", function()
	-- Victim 1 has "gem" as favourite (the pet) and a weaker "blob".
	local function petSetup()
		local world = ServerFixtures.world()
		local victim = ServerFixtures.join(world, 1, { Fixtures.slime("gem", 4), Fixtures.slime("blob", 1) })
		ServerFixtures.join(world, 2)
		ServerFixtures.unlock(victim)
		victim.data.favoriteId = "gem"
		return world, victim
	end
	it("a stolen pet stops following its owner", function()
		local world, victim = petSetup()
		expect((World.pet(world, victim) :: any).id).toBe("gem")
		expect((Carry.grab(world, 2, "gem", 1, T0))).toBe(true)
		expect((World.pet(world, victim) :: any).id).toBe("blob")
	end)
	it("a delivered pet is gone for good", function()
		local world, victim = petSetup()
		Carry.grab(world, 2, "gem", 1, T0)
		expect((Carry.deposit(world, 2))).toBe(true)
		expect(victim.data.favoriteId).toBeNil()
		expect((World.pet(world, victim) :: any).id).toBe("blob")
	end)
	it("a pet that escapes home follows again", function()
		local world, victim = petSetup()
		Carry.grab(world, 2, "gem", 1, T0)
		Carry.release(world, 2, T0 + 1, nil, "drop")
		expect(world.carriedBy.gem).toBeNil()
		expect((World.pet(world, victim) :: any).id).toBe("gem")
	end)
	it("a Mystery Egg never rides the cloud, even as the favourite", function()
		local world = ServerFixtures.world()
		local egg = Fixtures.slime("egg", 6, { egg = { kind = "speckled", hatchAt = 1e12 } })
		local victim = ServerFixtures.join(world, 1, { egg, Fixtures.slime("blob", 1) })
		victim.data.favoriteId = "egg"
		expect((World.pet(world, victim) :: any).id).toBe("blob")
		egg.egg = nil -- hatched: the favourite follows again
		expect((World.pet(world, victim) :: any).id).toBe("egg")
	end)
	it("no pet while every slime is still an egg", function()
		local world = ServerFixtures.world()
		local victim =
			ServerFixtures.join(world, 1, { Fixtures.slime("egg", 6, { egg = { kind = "speckled", hatchAt = 1e12 } }) })
		expect(World.pet(world, victim)).toBeNil()
	end)
	it("no pet while the only slime is carried away", function()
		local world = ServerFixtures.world()
		local victim = ServerFixtures.join(world, 1, { Fixtures.slime("gem", 4) })
		ServerFixtures.join(world, 2)
		ServerFixtures.unlock(victim)
		Carry.grab(world, 2, "gem", 1, T0)
		expect(World.pet(world, victim)).toBeNil()
	end)
end)

describe("StealService escape", function()
	it("a dropped slime bounces home", function()
		local world, victim, thief = setup()
		ServerFixtures.unlock(victim)
		Carry.grab(world, 2, "gem", 1, T0)
		expect((Carry.release(world, 2, T0 + 5, nil, "drop"))).toBe(true)
		expect(thief.carry).toBeNil()
		expect(world.carriedBy.gem).toBeNil()
		expect(world.escaping.gem).toBe(T0 + 5 + World.ESCAPE_BOUNCE_SECONDS)
		expect(PlayerData.findSlime(victim.data, "gem") ~= nil).toBeTruthy()
		local escaped = false
		for _, e in world.outbox do
			escaped = escaped or (e.type == "Escaped" and e.slimeId == "gem" and e.carrierUserId == 2)
		end
		expect(escaped).toBe(true)
	end)
	it("a thief can hold a stolen slime as long as they like", function()
		local world, victim, thief = setup()
		ServerFixtures.unlock(victim)
		Carry.grab(world, 2, "gem", 1, T0)
		for i = 1, 600 do
			GameLoop.step(world, T0 + i)
		end
		expect(thief.carry ~= nil).toBeTruthy()
		expect(world.carriedBy.gem).toBe(2)
	end)
	it("the bounce ends after ESCAPE_BOUNCE_SECONDS and the slime pays again", function()
		local world, victim = setup()
		ServerFixtures.unlock(victim)
		Carry.grab(world, 2, "gem", 1, T0)
		local carrier = World.session(world, 2)
		assert(carrier, "carrier")
		StealService.escape(world, carrier, T0 + 5, "drop")
		expect(World.isBusy(world, "gem")).toBe(true)
		StealService.step(world, T0 + 5 + World.ESCAPE_BOUNCE_SECONDS)
		expect(World.isBusy(world, "gem")).toBe(false)
		expect(World.incomeOf(world, victim) > 0).toBeTruthy()
	end)
	it("Drop of a stolen slime sends it home", function()
		local world, victim, thief = setup()
		ServerFixtures.unlock(victim)
		Carry.grab(world, 2, "gem", 1, T0)
		Carry.release(world, 2, T0 + 1, nil, "drop")
		expect(thief.carry).toBeNil()
		expect(world.escaping.gem ~= nil).toBeTruthy()
	end)
end)

describe("StealService unsaveable sessions", function()
	-- Victim 1 owns "gem", thief 2 is next to it; both loaded through a DataService on the memory backend, which
	-- also answers World.canSave. `victimRecord` / `thiefRecord` seed the stored records before loading.
	local function savedSetup(victimRecord: any?, thiefRecord: any?)
		local backend = DataService.memoryBackend()
		local svc = DataService.new({
			backend = backend,
			jobId = "job-A",
			now = function()
				return T0
			end,
			wait = function() end,
			log = function() end,
		})
		backend.records["u_1"] = victimRecord
		backend.records["u_2"] = thiefRecord
		DataService.load(svc, 1)
		DataService.load(svc, 2)
		local world = World.new({
			now = T0,
			seed = 7,
			canSave = function(userId: number): boolean
				return DataService.canSave(svc, userId)
			end,
		})
		local victim = ServerFixtures.join(world, 1, { Fixtures.slime("gem", 4) })
		local thief = ServerFixtures.join(world, 2)
		ServerFixtures.unlock(victim)
		return world, victim, thief, svc, backend
	end
	local function newerRecord()
		return { data = { version = Config.SAVE_VERSION + 1 }, session = nil }
	end
	-- Another server takes `userId`'s session over; this server finds out on its next save.
	local function loseSession(svc: any, backend: any, session: World.Session)
		backend.records[`u_{session.userId}`].session = { jobId = "job-B", time = T0 }
		DataService.save(svc, session.userId, session.data, false)
	end
	local function expectStillVictims(world: World.World, victim: World.Session, thief: World.Session)
		expect(PlayerData.findSlime(victim.data, "gem") ~= nil).toBe(true)
		expect(PlayerData.findSlime(thief.data, "gem")).toBeNil()
		expect(thief.carry).toBeNil()
		expect(world.carriedBy.gem).toBeNil()
		expect(thief.data.totalStolen).toBe(0)
	end

	it("steals normally when both players' saves are writable", function()
		local world = savedSetup()
		expect((Carry.grab(world, 2, "gem", 1, T0))).toBe(true)
		expect((Carry.deposit(world, 2, T0 + 5))).toBe(true)
	end)
	it("refuses a steal from a player whose save is read-only", function()
		local world, victim, thief = savedSetup(newerRecord())
		local ok, reason = Carry.grab(world, 2, "gem", 1, T0)
		expect(ok).toBe(false)
		expect(reason).toBe("their slimes can't be saved on this server")
		expectStillVictims(world, victim, thief)
	end)
	it("refuses a steal by a player whose save is read-only", function()
		local world, victim, thief = savedSetup(nil, newerRecord())
		expect(select(2, Carry.grab(world, 2, "gem", 1, T0))).toBe("your progress can't be saved on this server")
		expectStillVictims(world, victim, thief)
	end)
	it("refuses a steal by a player whose session another server took over", function()
		local world, victim, thief, svc, backend = savedSetup()
		loseSession(svc, backend, thief)
		expect(select(2, Carry.grab(world, 2, "gem", 1, T0))).toBe("your progress can't be saved on this server")
		expectStillVictims(world, victim, thief)
	end)
	it("sends the slime home when the victim's save stops being writable mid-carry", function()
		local world, victim, thief, svc, backend = savedSetup()
		expect((Carry.grab(world, 2, "gem", 1, T0))).toBe(true)
		loseSession(svc, backend, victim)
		local ok, reason = Carry.deposit(world, 2, T0 + 5)
		expect(ok).toBe(false)
		expect(reason).toBe("can't be saved")
		expectStillVictims(world, victim, thief)
		expect(world.escaping.gem).toBe(T0 + 5 + World.ESCAPE_BOUNCE_SECONDS)
		expect(#ServerFixtures.notifications(world, 2) > 0).toBe(true)
	end)
	it("sends the slime home when the thief's save stops being writable mid-carry", function()
		local world, victim, thief, svc, backend = savedSetup()
		expect((Carry.grab(world, 2, "gem", 1, T0))).toBe(true)
		loseSession(svc, backend, thief)
		expect(select(2, Carry.deposit(world, 2, T0 + 5))).toBe("can't be saved")
		expectStillVictims(world, victim, thief)
		expect(world.escaping.gem).toBe(T0 + 5 + World.ESCAPE_BOUNCE_SECONDS)
	end)
end)

describe("StealService: the thief must be inside", function()
	it("refuses a grab from outside the owner's base and leaves the slime on its pad", function()
		local world, victim, thief = setup()
		local now = T0 + Config.JOIN_LOCK_SECONDS + 1
		expect(select(2, Carry.grab(world, 2, "gem", 1, now, false))).toBe("Go inside their base to steal")
		expect(thief.carry).toBeNil()
		expect(world.carriedBy.gem).toBeNil()
		expect(PlayerData.findSlime(victim.data, "gem") ~= nil).toBe(true)
		expect((Carry.grab(world, 2, "gem", 1, now, true))).toBe(true)
		expect(thief.carry and thief.carry.slimeId).toBe("gem")
	end)
end)
