--!strict
local Carry = require("../src/server/Carry")
local CashPadService = require("../src/server/CashPadService")
local CashPads = require("../src/shared/CashPads")
local Config = require("../src/shared/Config")
local Economy = require("../src/shared/Economy")
local Fixtures = require("./Fixtures")
local Income = require("../src/server/Income")
local Perks = require("../src/shared/Perks")
local PlayerData = require("../src/shared/PlayerData")
local Progression = require("../src/shared/Progression")
local SaveData = require("../src/shared/SaveData")
local ServerFixtures = require("./ServerFixtures")
local Snapshot = require("../src/server/Snapshot")
local TestRunner = require("./TestRunner")

local describe, it, expect = TestRunner.describe, TestRunner.it, TestRunner.expect
local T0 = ServerFixtures.T0
local ON = table.freeze({ CashPads = true })
local OFF = table.freeze({ CashPads = false })

local function padOf(data: PlayerData.Data, id: string): number
	local slime = PlayerData.findSlime(data, id)
	assert(slime and slime.pad, "slime has no pad")
	return slime.pad
end

describe("CashPads piles", function()
	it("fills each pad from its own slime", function()
		local data = Fixtures.data({ Fixtures.slime("a", 1), Fixtures.slime("b", 3) }, 0)
		CashPads.accrue(data, 10)
		local a, b = PlayerData.findSlime(data, "a"), PlayerData.findSlime(data, "b")
		assert(a and b, "slimes missing")
		expect(CashPads.pile(data, padOf(data, "a"))).toBeCloseTo(PlayerData.slimeIncome(data, a) * 10, 1e-6)
		expect(CashPads.pile(data, padOf(data, "b"))).toBeCloseTo(PlayerData.slimeIncome(data, b) * 10, 1e-6)
		expect(data.cash).toBe(0)
	end)
	it("stops at the offline cap time of income and Night Shift raises it", function()
		local data = Fixtures.data({ Fixtures.slime("a", 2) }, 0)
		local slime = PlayerData.findSlime(data, "a")
		assert(slime, "slime missing")
		local perSec = PlayerData.slimeIncome(data, slime)
		local pad = padOf(data, "a")
		CashPads.accrue(data, Config.OFFLINE_CAP_SECONDS * 3)
		expect(CashPads.pile(data, pad)).toBeCloseTo(perSec * Config.OFFLINE_CAP_SECONDS, 1e-6)
		expect(CashPads.full(data, pad)).toBe(true)
		data.upgrades.OfflineCap = 1
		expect(CashPads.full(data, pad)).toBe(false)
		CashPads.accrue(data, Config.OFFLINE_CAP_SECONDS * 3)
		expect(CashPads.pile(data, pad)).toBeCloseTo(perSec * Perks.offlineCap(data), 1e-6)
	end)
	it("skips slimes that earn nothing now", function()
		local data = Fixtures.data({ Fixtures.slime("a", 1) }, 0)
		CashPads.accrue(data, 10, { a = true })
		expect(CashPads.total(data)).toBe(0)
	end)
	it("collects whole cash, keeps the fraction and counts it as earned", function()
		local data = Fixtures.data({}, 0)
		CashPads.add(data, 2, 12.75, 1e9)
		expect(CashPads.collect(data, 2)).toBe(12)
		expect(data.cash).toBe(12)
		expect(data.totalEarned).toBe(12)
		expect(CashPads.pile(data, 2)).toBeCloseTo(0.75, 1e-9)
		expect(CashPads.collect(data, 2)).toBe(0)
		expect(CashPads.collect(data, 5)).toBe(0)
	end)
	it("keeps a pile on the pad when its slime leaves", function()
		local data = Fixtures.data({ Fixtures.slime("a", 1) }, 0)
		local pad = padOf(data, "a")
		CashPads.accrue(data, 100)
		local before = CashPads.pile(data, pad)
		PlayerData.removeSlime(data, "a")
		CashPads.accrue(data, 100)
		expect(CashPads.pile(data, pad)).toBe(before)
		expect(CashPads.full(data, pad)).toBe(false)
	end)
end)

describe("CashPads offline", function()
	it("puts each slime's offline income on its pad, capped", function()
		local data = Fixtures.data({ Fixtures.slime("a", 2) }, 0)
		local slime = PlayerData.findSlime(data, "a")
		assert(slime, "slime missing")
		local perSec = PlayerData.slimeIncome(data, slime)
		local added = CashPads.accrueOffline(data, T0 - 3600, T0)
		expect(added).toBe(Economy.offlineIncome(perSec, T0 - 3600, T0))
		expect(CashPads.pile(data, padOf(data, "a"))).toBe(added)
		expect(data.cash).toBe(0)
	end)
	it("Income.applyOffline piles instead of paying with the flag on", function()
		local world = ServerFixtures.world()
		local s = ServerFixtures.join(world, 1, { Fixtures.slime("a", 2) }, 0)
		s.data.lastOnline = T0 - Config.WELCOME_BACK_MIN_SECONDS - 3600
		local piled = Income.applyOffline(world, s, T0, ON)
		expect(piled > 0).toBe(true)
		expect(s.data.cash).toBe(0)
		expect(math.floor(CashPads.total(s.data))).toBe(piled)
		local welcome = s.welcome
		assert(welcome, "no welcome-back report")
		expect(welcome.cash).toBe(piled)
		expect(welcome.onPads).toBe(true)
	end)
	it("Income.applyOffline pays cash with the flag off", function()
		local world = ServerFixtures.world()
		local s = ServerFixtures.join(world, 1, { Fixtures.slime("a", 2) }, 0)
		s.data.lastOnline = T0 - 3600
		local paid = Income.applyOffline(world, s, T0, OFF)
		expect(s.data.cash).toBe(paid)
		expect(CashPads.total(s.data)).toBe(0)
	end)
end)

describe("CashPads in Income.step", function()
	it("piles income on pads and leaves cash alone with the flag on", function()
		local world = ServerFixtures.world()
		local s = ServerFixtures.join(world, 1, { Fixtures.slime("a", 2), Fixtures.slime("b", 1) }, 0)
		Income.step(world, 1, nil, ON)
		expect(s.data.cash).toBe(0)
		expect(CashPads.total(s.data)).toBeCloseTo(PlayerData.incomePerSecond(s.data), 1e-6)
	end)
	it("hints once a session how to collect while the tutorial runs", function()
		local world = ServerFixtures.world()
		local s = ServerFixtures.join(world, 1, { Fixtures.slime("a", 3) }, 0)
		s.data.tutorialStep = 1
		ServerFixtures.clearEvents(world)
		for _ = 1, 30 do
			Income.step(world, 1, nil, ON)
		end
		local hints = 0
		for _, text in ServerFixtures.notifications(world, 1) do
			if text == Income.CASH_PAD_HINT then
				hints += 1
			end
		end
		expect(hints).toBe(1)
		expect(s.cashPadHinted).toBe(true)
	end)
	it("does not hint players who finished the tutorial", function()
		local world = ServerFixtures.world()
		local s = ServerFixtures.join(world, 1, { Fixtures.slime("a", 3) }, 0)
		s.data.tutorialStep = 0
		ServerFixtures.clearEvents(world)
		for _ = 1, 30 do
			Income.step(world, 1, nil, ON)
		end
		for _, text in ServerFixtures.notifications(world, 1) do
			expect(text == Income.CASH_PAD_HINT).toBe(false)
		end
	end)
	it("marks an earning session dirty every second", function()
		local world = ServerFixtures.world()
		local s = ServerFixtures.join(world, 1, { Fixtures.slime("a", 1) }, 0)
		s.dirty = false
		Income.step(world, 1, nil, ON)
		expect(s.dirty).toBe(true)
	end)
	it("pays cash as before with the flag off", function()
		local world = ServerFixtures.world()
		local s = ServerFixtures.join(world, 1, { Fixtures.slime("a", 2), Fixtures.slime("b", 1) }, 0)
		Income.step(world, 1, nil, OFF)
		expect(s.data.cash).toBe(4)
		expect(CashPads.total(s.data)).toBe(0)
	end)
	it("a slime being carried away adds nothing to its pad", function()
		local world = ServerFixtures.world()
		local victim = ServerFixtures.join(world, 1, { Fixtures.slime("a", 1), Fixtures.slime("b", 2) }, 0)
		ServerFixtures.join(world, 2)
		ServerFixtures.unlock(victim)
		local pad = padOf(victim.data, "b")
		Carry.grab(world, 2, "b", 1, T0)
		Income.step(world, 1, nil, ON)
		expect(CashPads.pile(victim.data, pad)).toBe(0)
		expect(CashPads.pile(victim.data, padOf(victim.data, "a")) > 0).toBe(true)
	end)
end)

describe("CashPadService.touch", function()
	it("the owner collects their pad", function()
		local world = ServerFixtures.world()
		local s = ServerFixtures.join(world, 1, { Fixtures.slime("a", 1) }, 0)
		local pad = padOf(s.data, "a")
		CashPads.add(s.data, pad, 250.5, 1e9)
		local paid = CashPadService.touch(world, {}, 1, s.plotIndex, pad, T0, ON)
		expect(paid).toBe(250)
		expect(s.data.cash).toBe(250)
		expect(s.dirty).toBe(true)
	end)
	it("another player gets nothing and one nag per NAG_SECONDS", function()
		local world = ServerFixtures.world()
		local s = ServerFixtures.join(world, 1, { Fixtures.slime("a", 1) }, 0)
		local thief = ServerFixtures.join(world, 2, {}, 0)
		local pad = padOf(s.data, "a")
		CashPads.add(s.data, pad, 900, 1e9)
		local nags = {}
		ServerFixtures.clearEvents(world)
		expect(CashPadService.touch(world, nags, 2, s.plotIndex, pad, T0, ON)).toBe(0)
		expect(CashPadService.touch(world, nags, 2, s.plotIndex, pad, T0 + 1, ON)).toBe(0)
		expect(thief.data.cash).toBe(0)
		expect(CashPads.pile(s.data, pad)).toBe(900)
		expect(#ServerFixtures.notifications(world, 2)).toBe(1)
		CashPadService.touch(world, nags, 2, s.plotIndex, pad, T0 + Config.CASH_PAD.NAG_SECONDS, ON)
		expect(#ServerFixtures.notifications(world, 2)).toBe(2)
	end)
	it("does nothing with the flag off, on an empty plot or a locked pad", function()
		local world = ServerFixtures.world()
		local s = ServerFixtures.join(world, 1, { Fixtures.slime("a", 1) }, 0)
		CashPads.add(s.data, 1, 50, 1e9)
		expect(CashPadService.touch(world, {}, 1, s.plotIndex, 1, T0, OFF)).toBe(0)
		expect(CashPadService.touch(world, {}, 1, s.plotIndex + 1, 1, T0, ON)).toBe(0)
		expect(CashPadService.touch(world, {}, 1, s.plotIndex, s.data.padsUnlocked + 1, T0, ON)).toBe(0)
		expect(CashPads.pile(s.data, 1)).toBe(50)
	end)
end)

describe("CashPads saves and rebirth", function()
	it("round-trips piles through the save", function()
		local data = Fixtures.data({ Fixtures.slime("a", 1) }, 0)
		CashPads.add(data, 1, 123.5, 1e9)
		CashPads.add(data, 3, 7, 1e9)
		local loaded = SaveData.deserialize(SaveData.serialize(data, T0))
		expect(CashPads.pile(loaded, 1)).toBe(123.5)
		expect(CashPads.pile(loaded, 2)).toBe(0)
		expect(CashPads.pile(loaded, 3)).toBe(7)
	end)
	it("an old save without piles loads with empty pads and saves no key", function()
		local loaded = SaveData.deserialize(SaveData.serialize(Fixtures.data({}, 10), T0))
		expect(loaded.padCash).toBe(nil)
		expect(SaveData.serialize(loaded, T0).padCash).toBe(nil)
	end)
	it("puts discs further out on the lower floors and keeps the top jar's disc clear of the stair hole", function()
		local fronts = Config.CASH_PAD.FRONT
		expect(CashPads.front(1)).toBe(fronts[1])
		expect(CashPads.front(Config.PADS_PER_FLOOR + 1)).toBe(fronts[2])
		expect(CashPads.front(Config.PADS_MAX)).toBe(fronts[math.min(#Config.BASE_FLOORS, #fronts)])
		expect(CashPads.front(Config.PADS_MAX + 8)).toBe(fronts[#fronts])
	end)
	it("drops junk, negative and locked-pad entries", function()
		local map = CashPads.clean({ 5, -3, "x", 0 / 0, 9 }, 4)
		assert(map, "no piles")
		expect(map[1]).toBe(5)
		expect(map[2]).toBe(nil)
		expect(map[3]).toBe(nil)
		expect(map[4]).toBe(nil)
		expect(map[5]).toBe(nil)
		expect(CashPads.clean("junk", 4)).toBe(nil)
		expect(CashPads.clean({ 0, -1 }, 4)).toBe(nil)
	end)
	it("rebirth clears the piles with the cash", function()
		local first = Config.REBIRTH_SLIMES[1][1]
		local data = Fixtures.data({ Fixtures.slime("b", 2, { species = first }) }, Economy.rebirthCost(0))
		CashPads.add(data, 1, 1000, 1e9)
		expect((Progression.rebirth(data))).toBe(true)
		expect(CashPads.total(data)).toBe(0)
		expect(data.cash).toBe(Config.STARTING_CASH)
	end)
end)

describe("CashPads in State", function()
	it("State.padCash is the whole cash waiting, only with the flag on", function()
		local world = ServerFixtures.world()
		local s = ServerFixtures.join(world, 1, { Fixtures.slime("a", 1) }, 0)
		CashPads.add(s.data, 1, 41.9, 1e9)
		CashPads.add(s.data, 2, 8.5, 1e9)
		local state = Snapshot.build(world, s, T0)
		expect(state.padCash).toBe(if Config.FEATURES.CashPads then 50 else nil)
	end)
end)
