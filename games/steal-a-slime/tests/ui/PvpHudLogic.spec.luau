--!strict
-- FEATURES.PvP HUD maths (src/ui/PvpHudLogic): cooldown ring rotations, clock and chip texts, key numbers.
local PvpHudLogic = require("../../src/ui/PvpHudLogic")
local TestRunner = require("../TestRunner")

local describe, it, expect = TestRunner.describe, TestRunner.it, TestRunner.expect

describe("PvpHudLogic.ring", function()
	it("sweeps the right half 0..180 and then the left half 180..360 (clockwise from 12 o'clock)", function()
		local none = PvpHudLogic.ring(0)
		expect(none.showRight).toBe(false)
		expect(none.showLeft).toBe(false)
		local quarter = PvpHudLogic.ring(0.25)
		expect(quarter.rightRotation).toBe(90)
		expect(quarter.leftRotation).toBe(180)
		expect(quarter.showRight).toBe(true)
		expect(quarter.showLeft).toBe(false)
		local half = PvpHudLogic.ring(0.5)
		expect(half.rightRotation).toBe(180)
		expect(half.leftRotation).toBe(180)
		expect(half.showLeft).toBe(false)
		local threeQuarters = PvpHudLogic.ring(0.75)
		expect(threeQuarters.rightRotation).toBe(180)
		expect(threeQuarters.leftRotation).toBe(270)
		expect(threeQuarters.showLeft).toBe(true)
		local full = PvpHudLogic.ring(1)
		expect(full.rightRotation).toBe(180)
		expect(full.leftRotation).toBe(360)
	end)

	it("is monotonic and stays inside 0..180 / 180..360 for any fraction", function()
		local lastRight, lastLeft = 0, 180
		for i = 0, 100 do
			local ring = PvpHudLogic.ring(i / 100)
			expect(ring.rightRotation >= lastRight and ring.leftRotation >= lastLeft).toBe(true)
			expect(ring.rightRotation <= 180 and ring.leftRotation <= 360 and ring.leftRotation >= 180).toBe(true)
			lastRight, lastLeft = ring.rightRotation, ring.leftRotation
		end
	end)

	it("clamps out-of-range, NaN, infinite and non-number input (never NaN out)", function()
		for _, bad in { -1, 2, 0 / 0, math.huge, -math.huge, "x", false } do
			local ring = PvpHudLogic.ring(bad)
			expect(ring.rightRotation == ring.rightRotation and ring.leftRotation == ring.leftRotation).toBe(true)
			expect(ring.rightRotation >= 0 and ring.rightRotation <= 180).toBe(true)
			expect(ring.leftRotation >= 180 and ring.leftRotation <= 360).toBe(true)
		end
		expect(PvpHudLogic.ring(2).leftRotation).toBe(360)
		expect(PvpHudLogic.ring(-1).showRight).toBe(false)
		expect(PvpHudLogic.ring(0 / 0).showRight).toBe(false)
		expect(PvpHudLogic.ring(nil).showRight).toBe(false)
	end)

	it("the step is a hard 50 % edge in ascending order", function()
		local keys = PvpHudLogic.RING_STEP
		expect(keys[1][1]).toBe(0)
		expect(keys[#keys][1]).toBe(1)
		for i = 2, #keys do
			expect(keys[i][1] > keys[i - 1][1]).toBe(true)
		end
		expect(keys[2][2]).toBe(0)
		expect(keys[3][2]).toBe(1)
	end)
end)

describe("PvpHudLogic texts", function()
	it("clock rounds up to m:ss and never goes negative or NaN", function()
		expect(PvpHudLogic.clock(0)).toBe("0:00")
		expect(PvpHudLogic.clock(0.2)).toBe("0:01")
		expect(PvpHudLogic.clock(59.9)).toBe("1:00")
		expect(PvpHudLogic.clock(61)).toBe("1:01")
		expect(PvpHudLogic.clock(600)).toBe("10:00")
		expect(PvpHudLogic.clock(-5)).toBe("0:00")
		expect(PvpHudLogic.clock(0 / 0)).toBe("0:00")
		expect(PvpHudLogic.clock(nil)).toBe("0:00")
	end)
	it("cooldown seconds show only above one second, rounded up", function()
		expect(PvpHudLogic.cooldownText(0)).toBe("")
		expect(PvpHudLogic.cooldownText(1)).toBe("")
		expect(PvpHudLogic.cooldownText(1.01)).toBe("2")
		expect(PvpHudLogic.cooldownText(12.4)).toBe("13")
		expect(PvpHudLogic.cooldownText(0 / 0)).toBe("")
		expect(PvpHudLogic.cooldownText(nil)).toBe("")
	end)
	it("shield and safe-zone chip texts hide when there is nothing to say", function()
		expect(PvpHudLogic.shieldText(false, 30)).toBeNil()
		expect(PvpHudLogic.shieldText(true, 272.4)).toBe("Shield 4:33")
		expect(PvpHudLogic.zoneText(nil)).toBeNil()
		expect(PvpHudLogic.zoneText("")).toBeNil()
		expect(PvpHudLogic.zoneText("Spawn")).toBe("Safe zone: Spawn")
	end)
	it("keyNumber maps the top-row digits and the keypad, nothing else", function()
		expect(PvpHudLogic.keyNumber("One")).toBe(1)
		expect(PvpHudLogic.keyNumber("Nine")).toBe(9)
		expect(PvpHudLogic.keyNumber("KeypadFive")).toBe(5)
		expect(PvpHudLogic.keyNumber("Zero")).toBeNil()
		expect(PvpHudLogic.keyNumber("W")).toBeNil()
		expect(PvpHudLogic.keyNumber(5)).toBeNil()
	end)
end)
