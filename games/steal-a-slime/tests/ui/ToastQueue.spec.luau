--!strict
-- Toast merge / priority / cap / staleness / menu rules (src/ui/ToastQueue.luau).
local TestRunner = require("../TestRunner")
local ToastQueue = require("../../src/ui/ToastQueue")

local describe, it, expect = TestRunner.describe, TestRunner.it, TestRunner.expect

local function texts(list: { any }): { string }
	local out = {}
	for _, e in list do
		table.insert(out, e.text)
	end
	return out
end

describe("ToastQueue merge", function()
	it("sums a burst of cash toasts", function()
		local q = ToastQueue.new()
		for i = 1, 5 do
			q.push("+$25", "good", i * 0.1)
		end
		expect(texts(q.step(1))).toEqual({ "+$125 (x5)" })
	end)
	it("keeps the sentence around the amount and formats with K", function()
		local q = ToastQueue.new()
		q.push("Sold for +$600!", "good", 0)
		q.push("Sold for +$650!", "good", 0.1)
		expect(texts(q.step(0.2))).toEqual({ "Sold for +$1.25K! (x2)" })
	end)
	it("counts identical plain text", function()
		local q = ToastQueue.new()
		for i = 1, 3 do
			q.push("Not enough cash", "bad", i)
		end
		expect(texts(q.step(3))).toEqual({ "Not enough cash (x3)" })
	end)
	it("does not merge different text or different kinds", function()
		local q = ToastQueue.new()
		q.push("Hello", "info", 0)
		q.push("Hello there", "info", 0)
		q.push("Hello", "good", 0)
		expect(#q.step(0)).toBe(3)
	end)
	it("refreshes the life of a shown toast", function()
		local q = ToastQueue.new()
		q.push("+$5", "good", 0)
		q.step(0)
		q.push("+$5", "good", 2.5)
		expect(#q.step(4)).toBe(1) -- would have expired at 3 s
		expect(#q.step(5.6)).toBe(0)
	end)
end)

describe("ToastQueue priority", function()
	it("ranks rare / badge / steal alerts above bad above routine", function()
		expect(ToastQueue.priority("x", "rare")).toBe(3)
		expect(ToastQueue.priority("x", "badge")).toBe(3)
		expect(ToastQueue.priority("Ann is stealing your Blorp!", "bad")).toBe(3)
		expect(ToastQueue.priority("Ann stole your Blorp!", "bad")).toBe(3)
		expect(ToastQueue.priority("Not enough cash", "bad")).toBe(2)
		expect(ToastQueue.priority("+$5", "good")).toBe(1)
		expect(ToastQueue.priority("hi", nil)).toBe(1)
	end)
	it("lists higher priority first, then oldest", function()
		local q = ToastQueue.new()
		q.push("routine", "info", 0)
		q.push("Not enough cash", "bad", 0)
		q.push("Ann stole your Blorp!", "bad", 0)
		q.push("routine 2", "info", 0)
		expect(texts(q.step(0))).toEqual({ "Ann stole your Blorp!", "Not enough cash", "routine", "routine 2" })
	end)
end)

describe("ToastQueue cap", function()
	it("shows at most max and lets a steal alert take a slot", function()
		local q = ToastQueue.new(2)
		q.push("a", "info", 0)
		q.push("b", "info", 0)
		q.push("c", "info", 0)
		expect(texts(q.step(0))).toEqual({ "a", "b" })
		q.push("Ann stole your Blorp!", "bad", 0.5)
		expect(texts(q.step(0.5))).toEqual({ "Ann stole your Blorp!", "a" })
	end)
	it("bounds the backlog, losing routine first", function()
		local q = ToastQueue.new()
		q.push("Ann stole your Blorp!", "bad", 0)
		for i = 1, 30 do
			q.push(`t{i}`, "info", 0)
		end
		expect(q.size()).toBe(ToastQueue.PENDING_MAX)
		expect(texts(q.step(0))[1]).toBe("Ann stole your Blorp!")
	end)
end)

describe("ToastQueue staleness", function()
	it("expires shown toasts after their kind's lifetime", function()
		local q = ToastQueue.new()
		q.push("hi", "info", 0)
		q.push("news", "rare", 0)
		expect(#q.step(0)).toBe(2)
		expect(texts(q.step(3.1))).toEqual({ "news" })
		expect(#q.step(7.1)).toBe(0)
	end)
	it("drops routine toasts that waited too long for a slot, keeps important ones", function()
		local q = ToastQueue.new(1)
		q.push("first", "rare", 0)
		q.push("routine", "info", 0)
		q.push("Not enough cash", "bad", 0)
		q.step(0)
		expect(q.size()).toBe(3)
		q.step(ToastQueue.STALE + 0.1)
		expect(q.size()).toBe(2) -- routine gone
	end)
end)

describe("ToastQueue menus", function()
	it("shows nothing while a menu is open and does not age meanwhile", function()
		local q = ToastQueue.new()
		q.push("hi", "info", 0)
		q.step(0)
		expect(#q.step(1, true)).toBe(0)
		expect(#q.step(20, true)).toBe(0)
		expect(#q.step(21, false)).toBe(1) -- only ~1 s of its 3 s life used
		expect(#q.step(23.5, false)).toBe(0)
	end)
	it("does not stale-drop queued routine toasts behind a menu", function()
		local q = ToastQueue.new()
		q.push("hi", "info", 0)
		q.step(0.1, true)
		q.step(30, true)
		expect(#q.step(30.1, false)).toBe(1)
	end)
end)
