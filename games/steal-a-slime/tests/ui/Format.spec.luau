--!strict
-- Pure UI text / time helpers (src/ui/Format.luau).
local Format = require("../../src/ui/Format")
local TestRunner = require("../TestRunner")

local describe, it, expect = TestRunner.describe, TestRunner.it, TestRunner.expect

describe("Format.formatCash", function()
	it("shows small amounts as whole dollars", function()
		expect(Format.formatCash(0)).toBe("$0")
		expect(Format.formatCash(25)).toBe("$25")
		expect(Format.formatCash(999.9)).toBe("$999")
	end)
	it("abbreviates with K / M / B and one decimal", function()
		expect(Format.formatCash(1000)).toBe("$1K")
		expect(Format.formatCash(1234)).toBe("$1.23K")
		expect(Format.formatCash(15300000)).toBe("$15.3M")
		expect(Format.formatCash(250000)).toBe("$250K")
		expect(Format.formatCash(2.5e9)).toBe("$2.5B")
	end)
	it("never rounds up past the suffix", function()
		expect(Format.formatCash(999999)).toBe("$999K")
		expect(Format.formatCash(99999)).toBe("$99.9K")
	end)
	it("handles negatives and non-finite values", function()
		expect(Format.formatCash(-1500)).toBe("-$1.5K")
		expect(Format.formatCash(0 / 0)).toBe("$0")
		expect(Format.formatCash(math.huge)).toBe("$0")
	end)
end)

describe("Format.formatRate / formatMultiplier", function()
	it("keeps one decimal for small fractional rates", function()
		expect(Format.formatRate(1.5)).toBe("$1.5/s")
		expect(Format.formatRate(3)).toBe("$3/s")
		expect(Format.formatRate(2500)).toBe("$2.5K/s")
		expect(Format.formatRate(0)).toBe("$0/s")
	end)
	it("formats multipliers", function()
		expect(Format.formatMultiplier(1)).toBe("x1")
		expect(Format.formatMultiplier(1.5)).toBe("x1.5")
	end)
end)

describe("Format.remainingSeconds", function()
	it("is untilTime - now, clamped at 0", function()
		expect(Format.remainingSeconds(110, 100)).toBe(10)
		expect(Format.remainingSeconds(90, 100)).toBe(0)
		expect(Format.remainingSeconds(nil, 100)).toBe(0)
	end)
end)

describe("Format.formatDuration", function()
	it("formats m:ss and h:mm:ss, rounding partial seconds up", function()
		expect(Format.formatDuration(0)).toBe("0:00")
		expect(Format.formatDuration(0.2)).toBe("0:01")
		expect(Format.formatDuration(45)).toBe("0:45")
		expect(Format.formatDuration(65)).toBe("1:05")
		expect(Format.formatDuration(3725)).toBe("1:02:05")
		expect(Format.formatDuration(-5)).toBe("0:00")
	end)
end)

describe("Format clock sync", function()
	it("ticks server time locally from the last snapshot offset", function()
		local offset = Format.clockOffset(1000, 20)
		expect(Format.serverNow(offset, 20)).toBe(1000)
		expect(Format.serverNow(offset, 25.5)).toBe(1005.5)
		expect(Format.remainingSeconds(1030, Format.serverNow(offset, 25))).toBe(25)
	end)
	it("computes countdown progress", function()
		expect(Format.progress(0, 20, 5)).toBe(0.25)
		expect(Format.progress(0, 20, 50)).toBe(1)
		expect(Format.progress(10, 10, 5)).toBe(1)
	end)
end)

describe("Format.dexLabel / dexCount", function()
	local names = { "Common", "Uncommon", "Rare" }
	it("labels dex keys", function()
		expect(Format.dexLabel("3:Glow:Spots:Happy", names)).toBe("Rare · Glow · Spots · Happy")
		expect(Format.dexLabel("1:None:Plain:Round", names)).toBe("Common · Plain · Round")
		expect(Format.dexLabel("9:None:Plain:Round", names)).toBe("Tier 9 · Plain · Round")
		expect(Format.dexLabel("garbage", names)).toBe("garbage")
		-- Save id "Lava" displays as "Syrup" (docs/archive/RANCH_RENAME.md); unmapped ids show as-is.
		local shown = { Lava = "Syrup" }
		expect(Format.dexLabel("3:Lava:Spots:Happy", names, shown)).toBe("Rare · Syrup · Spots · Happy")
		expect(Format.dexLabel("3:Glow:Spots:Happy", names, shown)).toBe("Rare · Glow · Spots · Happy")
	end)
	it("counts discoveries", function()
		expect(Format.dexCount(36, 720)).toBe("36 / 720 (5%)")
		expect(Format.dexCount(0, 0)).toBe("0 / 0 (0%)")
	end)
end)
