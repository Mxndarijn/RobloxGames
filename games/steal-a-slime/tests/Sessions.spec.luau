--!strict
local Carry = require("../src/server/Carry")
local Config = require("../src/shared/Config")
local Fixtures = require("./Fixtures")
local PlayerData = require("../src/shared/PlayerData")
local SafeCall = require("../src/server/SafeCall")
local ServerFixtures = require("./ServerFixtures")
local Sessions = require("../src/server/Sessions")
local Spawner = require("../src/server/Spawner")
local TestRunner = require("./TestRunner")

local describe, it, expect = TestRunner.describe, TestRunner.it, TestRunner.expect
local T0 = ServerFixtures.T0

-- Runs `fn` while Carry.release throws, restoring it afterwards even when `fn` fails.
local function withThrowingCarryRelease(fn: () -> ())
	local original = Carry.release
	Carry.release = function(): boolean
		error("carry state broken")
	end
	local ok, err = pcall(fn)
	Carry.release = original
	if not ok then
		error(err, 0)
	end
end

describe("Sessions", function()
	it("assigns the lowest free plot and reuses freed plots", function()
		local world = ServerFixtures.world()
		expect(ServerFixtures.join(world, 10).plotIndex).toBe(1)
		expect(ServerFixtures.join(world, 20).plotIndex).toBe(2)
		Sessions.leave(world, 10, T0)
		expect(world.plots[1]).toBeNil()
		expect(ServerFixtures.join(world, 30).plotIndex).toBe(1)
	end)
	it("refuses when every plot is taken", function()
		local world = ServerFixtures.world()
		for i = 1, Config.PLOT_COUNT do
			ServerFixtures.join(world, i)
		end
		local session, reason = Sessions.join(world, 99, "P99", PlayerData.new(), T0)
		expect(session).toBeNil()
		expect(reason).toBe("server is full")
	end)
	it("joining twice returns the same session", function()
		local world = ServerFixtures.world()
		local a = ServerFixtures.join(world, 1)
		expect(Sessions.join(world, 1, "P1", PlayerData.new(), T0)).toBe(a)
	end)
	it("a thief leaving sends the stolen slime home", function()
		local world = ServerFixtures.world()
		local victim = ServerFixtures.join(world, 1, { Fixtures.slime("gem", 3) })
		ServerFixtures.join(world, 2)
		ServerFixtures.unlock(victim)
		Carry.grab(world, 2, "gem", 1, T0)
		local left = Sessions.leave(world, 2, T0 + 1)
		expect(left and left.userId).toBe(2)
		expect(world.carriedBy.gem).toBeNil()
		expect(world.escaping.gem ~= nil).toBeTruthy()
		expect(PlayerData.findSlime(victim.data, "gem") ~= nil).toBeTruthy()
	end)
	it("a victim leaving ends the thief's carry; the slime stays in the victim's save", function()
		local world = ServerFixtures.world()
		local victim = ServerFixtures.join(world, 1, { Fixtures.slime("gem", 3) })
		local thief = ServerFixtures.join(world, 2)
		ServerFixtures.unlock(victim)
		Carry.grab(world, 2, "gem", 1, T0)
		local left = Sessions.leave(world, 1, T0 + 1)
		assert(left, "left")
		expect(PlayerData.findSlime(left.data, "gem") ~= nil).toBeTruthy()
		expect(thief.carry).toBeNil()
		expect(world.carriedBy.gem).toBeNil()
	end)
	it("leaving while carrying a wild slime drops it back into the wild", function()
		local world = ServerFixtures.world()
		ServerFixtures.join(world, 1)
		local id = Spawner.spawnOne(world, T0)
		world.wild[id].price = 0
		Carry.grab(world, 1, id, 1, T0)
		Sessions.leave(world, 1, T0)
		expect(world.wild[id] ~= nil).toBeTruthy()
		expect(world.carriedBy[id]).toBeNil()
		expect(Sessions.leave(world, 1, T0)).toBeNil()
	end)
	it("a leave step that throws is logged; the session still leaves and frees its plot", function()
		local world = ServerFixtures.world()
		local session = ServerFixtures.join(world, 1)
		local logs = {}
		local safeCall = SafeCall.new(function(message)
			table.insert(logs, message)
		end)
		local left
		withThrowingCarryRelease(function()
			left = Sessions.leave(world, 1, T0, safeCall)
		end)
		expect(left).toBe(session)
		expect(world.sessions[1]).toBeNil()
		expect(world.plots[session.plotIndex]).toBeNil()
		expect(#logs).toBe(1)
		expect(string.find(logs[1], "carry state broken", 1, true) ~= nil).toBeTruthy()
	end)
end)
