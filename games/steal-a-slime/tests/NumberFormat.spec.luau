--!strict
local NumberFormat = require("../src/shared/NumberFormat")
local TestRunner = require("./TestRunner")

local describe, it, expect = TestRunner.describe, TestRunner.it, TestRunner.expect

describe("NumberFormat.cash", function()
	it("keeps three significant digits and trims zeros", function()
		expect(NumberFormat.cash(0)).toBe("$0")
		expect(NumberFormat.cash(999)).toBe("$999")
		expect(NumberFormat.cash(1000)).toBe("$1K")
		expect(NumberFormat.cash(1250)).toBe("$1.25K")
		expect(NumberFormat.cash(9999)).toBe("$9.99K")
		expect(NumberFormat.cash(12500)).toBe("$12.5K")
		expect(NumberFormat.cash(125000)).toBe("$125K")
		expect(NumberFormat.cash(999999)).toBe("$999K")
		expect(NumberFormat.cash(1e6)).toBe("$1M")
		expect(NumberFormat.cash(1.25e6)).toBe("$1.25M")
		expect(NumberFormat.cash(1.25e9)).toBe("$1.25B")
		expect(NumberFormat.cash(1.15e3)).toBe("$1.15K")
	end)
	it("handles negatives and non-finite values", function()
		expect(NumberFormat.cash(-1250)).toBe("-$1.25K")
		expect(NumberFormat.cash(-5)).toBe("-$5")
		expect(NumberFormat.cash(0 / 0)).toBe("$0")
		expect(NumberFormat.cash(math.huge)).toBe("$0")
	end)
	it("short omits the dollar sign", function()
		expect(NumberFormat.short(12500)).toBe("12.5K")
	end)
end)

describe("NumberFormat.rate", function()
	it("keeps one truncated decimal below 100, the cash format above", function()
		expect(NumberFormat.rate(1.58)).toBe("$1.5/s")
		expect(NumberFormat.rate(0.88)).toBe("$0.8/s")
		expect(NumberFormat.rate(12)).toBe("$12/s")
		expect(NumberFormat.rate(99.99)).toBe("$99.9/s")
		expect(NumberFormat.rate(1250)).toBe("$1.25K/s")
		expect(NumberFormat.rate(0)).toBe("$0/s")
	end)
end)
