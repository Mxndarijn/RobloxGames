--!strict
-- The sand yard's dressing (src/visuals/shared/YardProps, generated by tools/yard/YardGen from a seed): the committed rows are the
-- generator's output, every prop keeps 4 studs of air from the boardwalk ring, the eight spokes, the gate ramps, the plot
-- entrances and fences, the spots, the slide and the lane, stands on the floor, keeps within the budgets, takes no snow
-- (SnowKind none) and never repeats itself.
local Config = require("../src/shared/Config")
local MeshAssets = require("../src/shared/MeshAssets")
local PropClearance = require("../src/visuals/shared/PropClearance")
local RanchProps = require("../src/visuals/shared/RanchProps")
local TestRunner = require("./TestRunner")
local WorldLayout = require("../src/visuals/shared/WorldLayout")
local YardGen = require("../tools/yard/YardGen")
local YardProps = require("../src/visuals/shared/YardProps")

local describe, it, expect = TestRunner.describe, TestRunner.it, TestRunner.expect

local yard: { WorldLayout.RanchProp } = {}
for _, p in WorldLayout.RANCH_PROPS do
	if p.cluster == "yard" then
		table.insert(yard, p)
	end
end

local function stddev(xs: { number }): number
	local mean = 0
	for _, x in xs do
		mean += x
	end
	mean /= #xs
	local v = 0
	for _, x in xs do
		v += (x - mean) ^ 2
	end
	return math.sqrt(v / #xs)
end

describe("yard dressing: the generated data", function()
	it(
		"is exactly what tools/yard/generate writes for the seed (rerun lune run tools/yard/generate, then gen-world)",
		function()
			local rows, patches = YardGen.generate()
			expect(#YardProps.PATCHES).toBe(#patches)
			for i, q in patches do
				local have = YardProps.PATCHES[i]
				expect(have[1]).toBe(q.name)
				expect(have[2]).toBe(q.kind)
				expect(have[3]).toBeCloseTo(q.angle)
				expect(have[4]).toBeCloseTo(q.r)
				expect(have[5]).toBeCloseTo(q.radius)
			end
			expect(#YardProps.ROWS).toBe(#rows)
			expect(YardProps.SEED).toBe(YardGen.SEED)
			for i, row in rows do
				local have = YardProps.ROWS[i]
				expect(have[1]).toBe(row.name)
				expect(have[2]).toBe(row.mesh)
				expect(have[3]).toBeCloseTo(row.angle)
				expect(have[4]).toBeCloseTo(row.r)
				expect(have[5]).toBeCloseTo(row.yaw)
				expect(have[6]).toBeCloseTo(row.scale)
				expect(have[7]).toEqual(row.tint)
			end
		end
	)
	it("becomes one 'yard' RanchProps placement per row", function()
		expect(#yard).toBe(#YardProps.ROWS)
		expect(table.find(RanchProps.CLUSTERS, "yard") ~= nil).toBe(true)
	end)
	it("dresses the yard without filling it: tens of props, many kinds, none repeated to death", function()
		expect(#yard >= 40 and #yard <= YardGen.MAX_PROPS).toBe(true)
		local count: { [string]: number } = {}
		for _, p in yard do
			count[p.mesh] = (count[p.mesh] or 0) + 1
		end
		local kinds = 0
		for mesh, n in count do
			kinds += 1
			expect(n <= (YardGen.CAP_OVERRIDE[mesh] or YardGen.MESH_CAP)).toBe(true)
		end
		expect(kinds >= 20).toBe(true)
	end)
	it("leaves open sand: the footprints cover under 3.5% of the yard (anchor scenes included)", function()
		local area = 0
		for _, p in yard do
			area += p.size[1] * p.size[3]
		end
		local ring = WorldLayout.RING_PATH_RADIUS + 5
		local sand = math.pi * (YardGen.YARD_EDGE ^ 2 - ring ^ 2)
		expect(area / sand < 0.035).toBe(true)
	end)
end)

describe("yard dressing: keep-clear (4 studs of air)", function()
	it(
		"keeps every footprint 4 studs off every keep-clear zone (ring path, plots and fences, entrances, spots, slide, lane)",
		function()
			local bad = {}
			local grow = 2 * (YardGen.CLEAR - PropClearance.MARGIN)
			for _, p in yard do
				local fat = { pos = p.pos, size = { p.size[1] + grow, p.size[2], p.size[3] + grow }, yaw = p.yaw }
				local hits = PropClearance.conflicts(fat)
				if #hits > 0 then
					table.insert(bad, `{p.name}: {table.concat(hits, ", ")}`)
				end
			end
			expect(bad).toEqual({})
		end
	)
	it(
		"keeps clear of the boardwalk's eight spokes, ramps and the ring: no footprint corner within 4 + half the spoke",
		function()
			local bad = {}
			for _, p in yard do
				local reach = p.radius
				local r = math.sqrt(p.pos[1] ^ 2 + p.pos[3] ^ 2)
				-- the ring path's outer rail is at r 82.8
				if r - reach < WorldLayout.RING_PATH_RADIUS + WorldLayout.RING_PATH_WIDTH / 2 + 4 then
					table.insert(bad, `{p.name}: ring`)
				end
				-- the spoke i runs from the plaza out to the plot's gate (r 100) along the plot's bearing
				for i = 1, Config.PLOT_COUNT do
					local centre = WorldLayout.plotCentre(i)
					local d = math.sqrt(centre[1] ^ 2 + centre[3] ^ 2)
					local ux, uz = centre[1] / d, centre[3] / d
					local along = p.pos[1] * ux + p.pos[3] * uz
					local across = math.abs(p.pos[1] * uz - p.pos[3] * ux)
					-- spoke 8 wide (+ rails), the ramp 8.4: half 4.2; the plot's gate corridor is 20 wide
					if along > -reach and along < 104 + reach and across - reach < 4.2 + 4 then
						table.insert(bad, `{p.name}: spoke {i}`)
					end
				end
			end
			expect(bad).toEqual({})
		end
	)
	it("stays inside the sand yard (r <= YARD_EDGE), not on the grass band", function()
		for _, p in yard do
			local reach = math.sqrt(p.pos[1] ^ 2 + p.pos[3] ^ 2) + p.radius
			expect(reach <= YardGen.YARD_EDGE + 1e-6).toBe(true)
		end
	end)
	it(
		"keeps the slide exit, the spawns and the shop fronts open (nothing inside r 86 or in front of the shop spots)",
		function()
			for _, p in yard do
				expect(math.sqrt(p.pos[1] ^ 2 + p.pos[3] ^ 2) - p.radius >= 86).toBe(true)
			end
		end
	)
end)

describe("yard dressing: floor, collision, snow, variety", function()
	local slots: { [string]: any } = {}
	local function walk(n: any)
		if n.name and string.sub(n.name, 1, 5) == "Yard_" then
			slots[n.name] = n
		end
		for _, c in n.children or {} do
			walk(c)
		end
	end
	for _, n in WorldLayout.build() do
		walk(n)
	end

	it("stands every prop's base on the floor (y = 0, nothing sunk below -0.25, nothing floating)", function()
		local n = 0
		for _, p in yard do
			local slot = slots[p.name]
			expect(slot ~= nil).toBe(true)
			local base = slot.pos[2] - slot.size[2] / 2
			expect(base >= -0.25).toBe(true)
			expect(math.abs(base) < 0.001).toBe(true)
			n += 1
		end
		expect(n).toBe(#yard)
	end)
	it("adds no collision of its own: only the kit's Box / Hull / Default fidelities, never PCD", function()
		for _, p in yard do
			local fidelity = MeshAssets.collision(p.mesh)
			expect(fidelity == nil or fidelity == "Box" or fidelity == "Hull" or fidelity == "Default").toBe(true)
			local slot = slots[p.name]
			expect(slot.canCollide == false or fidelity ~= nil).toBe(true)
		end
	end)
	it("stands an invisible, solid trunk post inside every yard tree's footprint (WorldLayout.TREE_TRUNKS)", function()
		local trees = 0
		for _, p in yard do
			local trunks = WorldLayout.TREE_TRUNKS[p.mesh]
			if trunks then
				trees += 1
				expect(MeshAssets.collision(p.mesh)).toBe(nil) -- the tree mesh stays decor: the posts are its collision
				for i, t in trunks do
					local post = slots[`{p.name}_Trunk{i}`]
					expect(post ~= nil).toBe(true)
					expect(post.transparency).toBe(1)
					expect(post.canCollide ~= false and post.canQuery ~= false).toBe(true)
					expect(post.size[1]).toBe(t[4] * p.scale)
					-- the post centre lies inside the tree's own footprint, with room for its radius
					local dx, dz = post.pos[1] - p.pos[1], post.pos[3] - p.pos[3]
					local yaw = math.rad(p.yaw)
					local lx = dx * math.cos(yaw) - dz * math.sin(yaw)
					local lz = dx * math.sin(yaw) + dz * math.cos(yaw)
					expect(math.abs(lx) + post.size[2] / 2 <= p.size[1] / 2).toBe(true)
					expect(math.abs(lz) + post.size[2] / 2 <= p.size[3] / 2).toBe(true)
				end
				expect(slots[`{p.name}_Trunk{#trunks + 1}`]).toBe(nil)
			end
		end
		expect(trees > 0).toBe(true)
	end)
	it("opts out of snow (SnowKind none) and wears a slight tint: MeshTint, near white", function()
		for _, p in yard do
			local slot = slots[p.name]
			expect(slot.attributes.SnowKind).toBe("none")
			expect(slot.attributes.MeshTint).toBe(true)
			expect(slot.attributes.MeshAsset).toBe(p.mesh)
			for k = 1, 3 do
				expect(slot.color[k] >= 215 and slot.color[k] <= 255).toBe(true)
			end
		end
	end)
	it("varies yaw, scale and tint: no two props alike, no row of copies", function()
		local scales, yaws, tints = {}, {}, {}
		for _, p in yard do
			scales[string.format("%.2f", p.scale)] = true
			table.insert(yaws, p.yaw)
			tints[table.concat(p.tint :: { number }, ",")] = true
		end
		local function size(t: { [string]: boolean }): number
			local n = 0
			for _ in t do
				n += 1
			end
			return n
		end
		expect(size(scales) >= 12).toBe(true)
		expect(size(tints) >= #yard * 0.9).toBe(true)
		expect(stddev(yaws) > 80).toBe(true)
		-- per mesh: copies never share a yaw or a scale
		local byMesh: { [string]: { WorldLayout.RanchProp } } = {}
		for _, p in yard do
			byMesh[p.mesh] = byMesh[p.mesh] or {}
			table.insert(byMesh[p.mesh], p)
		end
		for mesh, list in byMesh do
			-- a fence run is one design: its panels share a yaw (up to the jitter) and a scale
			for i = 1, if string.find(mesh, "fence") then 0 else #list do
				for j = i + 1, #list do
					expect(math.abs(list[i].yaw - list[j].yaw) > 1 or math.abs(list[i].scale - list[j].scale) > 0.02).toBe(
						true
					)
				end
			end
		end
	end)
	it("keeps the scale in the table's sane range", function()
		for _, p in yard do
			expect(p.scale >= 0.5 and p.scale <= 2).toBe(true)
		end
	end)
end)
