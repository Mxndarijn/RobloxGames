--!strict
local Carry = require("../src/server/Carry")
local Fixtures = require("./Fixtures")
local Scene = require("../src/server/Scene")
local ServerFixtures = require("./ServerFixtures")
local Spawner = require("../src/server/Spawner")
local StealService = require("../src/server/StealService")
local TestRunner = require("./TestRunner")

local describe, it, expect = TestRunner.describe, TestRunner.it, TestRunner.expect
local T0 = ServerFixtures.T0

describe("Scene.describe", function()
	it("lists wild slimes with price prompts", function()
		local world = ServerFixtures.world()
		local id = Spawner.spawnOne(world, T0)
		world.wild[id].price = 40
		local e = Scene.describe(world, T0)[id]
		expect(e.state).toBe("Wild")
		expect(e.ownerUserId).toBe(0)
		expect(e.price).toBe(40)
		expect(e.promptText).toBe("Buy $40")
		expect(e.promptEnabled).toBe(true)
	end)
	it("pad slimes say Steal, enabled only while the plot is unlocked", function()
		local world = ServerFixtures.world()
		local s = ServerFixtures.join(world, 1, { Fixtures.slime("a") })
		local e = Scene.describe(world, T0)["a"]
		expect(e.state).toBe("Pad")
		expect(e.ownerUserId).toBe(1)
		expect(e.plotIndex).toBe(1)
		expect(e.pad).toBe(1)
		expect(e.promptText).toBe("Steal")
		expect(e.promptEnabled).toBe(false)
		ServerFixtures.unlock(s)
		expect(Scene.describe(world, T0)["a"].promptEnabled).toBe(true)
	end)
	it("hides Steal prompts from the owner only", function()
		local world = ServerFixtures.world()
		local victim = ServerFixtures.join(world, 1, { Fixtures.slime("a", 2) })
		ServerFixtures.join(world, 2)
		ServerFixtures.unlock(victim)
		local wildId = Spawner.spawnOne(world, T0)
		expect(Scene.describe(world, T0)[wildId].hideFromUserId).toBeNil()
		local pad = Scene.describe(world, T0)["a"]
		expect(pad.promptText).toBe("Steal")
		expect(pad.hideFromUserId).toBe(1)
		Carry.grab(world, 2, "a", 1, T0)
		expect(Scene.describe(world, T0)["a"].hideFromUserId).toBeNil()
		Carry.deposit(world, 2)
		expect(Scene.describe(world, T0)["a"].hideFromUserId).toBe(2)
	end)
	it("tracks Carried -> Escaping -> Pad with a changing key", function()
		local world = ServerFixtures.world()
		local victim = ServerFixtures.join(world, 1, { Fixtures.slime("a", 2) })
		local thief = ServerFixtures.join(world, 2)
		ServerFixtures.unlock(victim)
		local keys = { Scene.describe(world, T0)["a"].key }
		Carry.grab(world, 2, "a", 1, T0)
		local carried = Scene.describe(world, T0)["a"]
		expect(carried.state).toBe("Carried")
		expect(carried.carrierUserId).toBe(2)
		expect(carried.promptEnabled).toBe(false)
		table.insert(keys, carried.key)
		StealService.escape(world, thief, T0 + 1, "drop")
		local escaping = Scene.describe(world, T0 + 1)["a"]
		expect(escaping.state).toBe("Escaping")
		table.insert(keys, escaping.key)
		StealService.step(world, T0 + 10)
		local back = Scene.describe(world, T0 + 10)["a"]
		expect(back.state).toBe("Pad")
		expect(keys[1] ~= keys[2] and keys[2] ~= keys[3] and keys[3] ~= back.key).toBeTruthy()
	end)
	it("a stolen slime moves to the thief's plot", function()
		local world = ServerFixtures.world()
		local victim = ServerFixtures.join(world, 1, { Fixtures.slime("a", 2) })
		ServerFixtures.join(world, 2)
		ServerFixtures.unlock(victim)
		Carry.grab(world, 2, "a", 1, T0)
		Carry.deposit(world, 2)
		local e = Scene.describe(world, T0)["a"]
		expect(e.ownerUserId).toBe(2)
		expect(e.plotIndex).toBe(2)
		expect(e.state).toBe("Pad")
	end)
end)
