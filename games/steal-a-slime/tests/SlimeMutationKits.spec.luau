--!strict
-- The recoloured species kits shining slimes wear (FEATURES.MutationLooks, contract/slime-ladder.md 45.5).
-- The MeshAssets block is generated by shared/modeling-kit/tools/slime_mutation_assets.py from uploaded.json.
local fs = require("@lune/fs")
local serde = require("@lune/serde")

local Config = require("../src/shared/Config")
local MeshAssets = require("../src/shared/MeshAssets")
local SlimeLooks = require("../src/shared/SlimeLooks")
local TestRunner = require("./TestRunner")

local describe, it, expect = TestRunner.describe, TestRunner.it, TestRunner.expect

describe("slime mutation kits", function()
	it(
		"the generated MeshAssets block matches the kit's uploaded.json (rerun tools/slime_mutation_assets.py)",
		function()
			local record = serde.decode("json", fs.readFile("../../shared/modeling-kit/uploaded.json"))
			local suffixes: { [string]: boolean } = {}
			for _, row in Config.SHINES do
				suffixes[row.kit] = true
			end
			local n = 0
			for name, upload in record do
				local kit, suffix = string.match(name, "^(slime_[%w_]+)_(%a+)$")
				if kit and suffix and suffixes[suffix] and MeshAssets.get(kit) then
					n += 1
					local entry = MeshAssets.get(name)
					local ok = entry ~= nil and tostring(entry.assetId) == tostring(upload.assetId)
					expect(`{name}: {ok}`).toBe(`{name}: true`)
				end
			end
			expect(n > 0).toBe(true)
		end
	)

	it("every species kit has a copy for every shine, in the species' size and offset", function()
		for _, kit in SlimeLooks.KITS do
			local base = MeshAssets.get(kit) :: MeshAssets.Entry
			for _, row in Config.SHINES do
				local name = MeshAssets.mutationKit(kit, row.kit)
				expect(`{kit} {row.id}: {name}`).toBe(`{kit} {row.id}: {kit}_{row.kit}`)
				local copy = MeshAssets.get(`{kit}_{row.kit}`)
				expect(copy ~= nil and copy.size == base.size and copy.offset == base.offset).toBe(true)
			end
		end
	end)

	it("names no copy for a missing kit or shine", function()
		expect(MeshAssets.mutationKit(nil, "gold")).toBeNil()
		expect(MeshAssets.mutationKit("slime_gummy", nil)).toBeNil()
		expect(MeshAssets.mutationKit("slime_nope", "gold")).toBeNil()
		expect(MeshAssets.mutationKit("slime_gummy", "mud")).toBeNil()
	end)
end)
