--!strict
local StackGuard = require("../src/server/StackGuard")
local TestRunner = require("./TestRunner")

local describe, it, expect = TestRunner.describe, TestRunner.it, TestRunner.expect

local HX, HY, HZ = 9.7, 6.4, 5.7

describe("StackGuard", function()
	it("a root inside the box is inside", function()
		expect(StackGuard.inside(0, 0, 0, HX, HY, HZ)).toBe(true)
		expect(StackGuard.inside(8, HY - 1, -4, HX, HY, HZ)).toBe(true)
	end)
	it("ejects to just above the top, same x / z", function()
		local x, y, z = StackGuard.ejectPoint(2, 1, -3, HX, HY, HZ, false)
		expect(x).toBe(2)
		expect(z).toBe(-3)
		expect(y).toBe(HY + StackGuard.LIFT)
		expect(StackGuard.inside(x, y, z, HX, HY, HZ)).toBe(false)
	end)
	it("a root standing on top or outside is left alone", function()
		expect(StackGuard.inside(0, HY + 3, 0, HX, HY, HZ)).toBe(false)
		expect(StackGuard.inside(HX + 1, 0, 0, HX, HY, HZ)).toBe(false)
		expect(StackGuard.inside(0, 0, -HZ - 2, HX, HY, HZ)).toBe(false)
		expect(StackGuard.inside(0, -HY - 1, 0, HX, HY, HZ)).toBe(false)
	end)
	it("boundary: the margin band and the top slack", function()
		expect(StackGuard.inside(HX - StackGuard.MARGIN, 0, 0, HX, HY, HZ)).toBe(false)
		expect(StackGuard.inside(HX - StackGuard.MARGIN - 0.01, 0, 0, HX, HY, HZ)).toBe(true)
		expect(StackGuard.inside(0, HY + StackGuard.TOP_SLACK, 0, HX, HY, HZ)).toBe(false)
		expect(StackGuard.inside(0, HY + StackGuard.TOP_SLACK - 0.01, 0, HX, HY, HZ)).toBe(true)
	end)
	it("a blocked top ejects radially outside the nearest face", function()
		local x, y, z = StackGuard.ejectPoint(8, 1, 0, HX, HY, HZ, true)
		expect(x).toBe(HX + StackGuard.OUTSIDE)
		expect(y).toBe(1)
		expect(z).toBe(0)
		local x2, _, z2 = StackGuard.ejectPoint(0, 1, -5, HX, HY, HZ, true)
		expect(x2).toBe(0)
		expect(z2).toBe(-(HZ + StackGuard.OUTSIDE))
		expect(StackGuard.inside(x, y, z, HX, HY, HZ)).toBe(false)
	end)
	it("a degenerate box never ejects", function()
		expect(StackGuard.inside(0, 0, 0, 0, 0, 0)).toBe(false)
	end)
end)
