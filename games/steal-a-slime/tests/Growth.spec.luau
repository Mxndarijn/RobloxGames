--!strict
-- Slime growth: curve, cap, offline cap, income multiplier, feature flag, old saves.
local Config = require("../src/shared/Config")
local Fixtures = require("./Fixtures")
local Genome = require("../src/shared/Genome")
local Growth = require("../src/shared/Growth")
local Income = require("../src/server/Income")
local PlayerData = require("../src/shared/PlayerData")
local SaveData = require("../src/shared/SaveData")
local ServerFixtures = require("./ServerFixtures")
local TestRunner = require("./TestRunner")

local describe, it, expect = TestRunner.describe, TestRunner.it, TestRunner.expect
local T0 = ServerFixtures.T0

local function approx(a: number, b: number): boolean
	return math.abs(a - b) < 1e-6
end

describe("Growth curve", function()
	it("rises linearly with pad time and reaches 1 after GROWTH_SECONDS", function()
		local s = Fixtures.slime("a", 2)
		expect(Genome.growthFraction(s)).toBe(0)
		Growth.advance(s, Config.GROWTH_SECONDS / 4)
		expect(approx(Genome.growthFraction(s), 0.25)).toBe(true)
		Growth.advance(s, Config.GROWTH_SECONDS / 4)
		expect(approx(Genome.growthFraction(s), 0.5)).toBe(true)
		Growth.advance(s, Config.GROWTH_SECONDS / 2)
		expect(Genome.growthFraction(s)).toBe(1)
	end)
	it("is capped at 1 and ignores zero, negative and NaN time", function()
		local s = Fixtures.slime("a", 2)
		Growth.advance(s, Config.GROWTH_SECONDS * 10)
		expect(s.growth).toBe(1)
		expect(Growth.advance(s, 100)).toBe(false)
		local t = Fixtures.slime("b", 2)
		expect(Growth.advance(t, 0)).toBe(false)
		expect(Growth.advance(t, -5)).toBe(false)
		expect(Growth.advance(t, 0 / 0)).toBe(false)
		expect(t.growth).toBeNil()
	end)
	it("skips carried slimes in advanceAll", function()
		local a, b = Fixtures.slime("a", 1), Fixtures.slime("b", 1)
		Growth.advanceAll({ a, b }, 60, { b = true })
		expect(a.growth ~= nil).toBe(true)
		expect(b.growth).toBeNil()
	end)
	it("scale follows the percent", function()
		local s = Fixtures.slime("a", 1, { growth = 0.5 })
		expect(Growth.percent(s)).toBe(50)
		expect(approx(Growth.scale(s), 1 + Config.GROWTH_MAX_SCALE_BONUS * 0.5)).toBe(true)
		expect(Growth.percent(Fixtures.slime("b", 1))).toBe(0)
		expect(approx(Growth.scale(Fixtures.slime("c", 1, { growth = 1 })), 1 + Config.GROWTH_MAX_SCALE_BONUS)).toBe(
			true
		)
	end)
end)

describe("Growth income", function()
	it("multiplies base income up to 1 + GROWTH_MAX_INCOME_BONUS", function()
		local plain = Fixtures.slime("a", 3)
		local base = Genome.baseIncome(plain)
		local half = Fixtures.slime("b", 3, { growth = 0.5 })
		local full = Fixtures.slime("c", 3, { growth = 1 })
		expect(approx(Genome.baseIncome(half), base * (1 + Config.GROWTH_MAX_INCOME_BONUS / 2))).toBe(true)
		expect(approx(Genome.baseIncome(full), base * (1 + Config.GROWTH_MAX_INCOME_BONUS))).toBe(true)
		expect(Genome.baseIncome(Fixtures.slime("d", 3, { growth = 99 })) <= Genome.baseIncome(full) + 1e-9).toBe(true)
	end)
	it("Income.step grows slimes on the plot and pays the grown rate", function()
		local world = ServerFixtures.world()
		local s = ServerFixtures.join(world, 1, { Fixtures.slime("a", 2) }, 0)
		Income.step(world, 1)
		local slime = s.data.slimes[1]
		expect(approx(slime.growth :: number, 1 / Config.GROWTH_SECONDS)).toBe(true)
		expect(PlayerData.slimeIncome(s.data, slime) > Genome.baseIncome(Fixtures.slime("x", 2)) - 1e-9).toBe(true)
	end)
	it("is behind FEATURES.GrowingSlimes, default on", function()
		expect(Config.FEATURES.GrowingSlimes).toBe(true)
		expect(Growth.enabled()).toBe(true)
	end)
end)

describe("Growth offline", function()
	it("counts time since lastOnline", function()
		local s = Fixtures.slime("a", 1)
		local credited = Growth.applyOffline({ s }, T0 - 3600, T0)
		expect(credited).toBe(3600)
		expect(approx(s.growth :: number, 3600 / Config.GROWTH_SECONDS)).toBe(true)
	end)
	it("caps the offline gap at GROWTH_OFFLINE_CAP_SECONDS", function()
		local s = Fixtures.slime("a", 1)
		local credited = Growth.applyOffline({ s }, T0 - 30 * 24 * 3600, T0)
		expect(credited).toBe(Config.GROWTH_OFFLINE_CAP_SECONDS)
		expect(approx(s.growth :: number, Config.GROWTH_OFFLINE_CAP_SECONDS / Config.GROWTH_SECONDS)).toBe(true)
	end)
	it("gives nothing for a missing lastOnline or clock skew", function()
		local s = Fixtures.slime("a", 1)
		expect(Growth.applyOffline({ s }, 0, T0)).toBe(0)
		expect(Growth.applyOffline({ s }, T0 + 100, T0)).toBe(0)
		expect(s.growth).toBeNil()
	end)
	it("applies on join through Income.applyOffline", function()
		local world = ServerFixtures.world()
		local s = ServerFixtures.join(world, 1, { Fixtures.slime("a", 1) }, 0)
		s.data.lastOnline = T0 - 1800
		s.data.slimes[1].growth = nil
		Income.applyOffline(world, s, T0)
		expect(approx(s.data.slimes[1].growth :: number, 1800 / Config.GROWTH_SECONDS)).toBe(true)
	end)
end)

describe("Growth save compatibility", function()
	it("an old save without growth loads with none and keeps its version", function()
		local stored = SaveData.serialize(Fixtures.data({ Fixtures.slime("a", 2) }, 10), T0)
		for _, raw in stored.slimes do
			raw.growth = nil
		end
		stored.version = Config.SAVE_VERSION
		local data = SaveData.deserialize(stored)
		expect(#data.slimes).toBe(1)
		expect(data.slimes[1].growth).toBeNil()
		expect(SaveData.serialize(data, T0).version).toBe(Config.SAVE_VERSION)
	end)
	it("round-trips growth and sanitizes garbage", function()
		local data = Fixtures.data({ Fixtures.slime("a", 2, { growth = 0.4321987 }), Fixtures.slime("b", 2) }, 10)
		local back = SaveData.deserialize(SaveData.serialize(data, T0))
		expect(back.slimes[1].growth).toBe(0.4322)
		expect(back.slimes[2].growth).toBeNil()
		local stored = SaveData.serialize(data, T0)
		stored.slimes[1].growth = 7
		stored.slimes[2].growth = "x"
		local clamped = SaveData.deserialize(stored)
		expect(clamped.slimes[1].growth).toBe(1)
		expect(clamped.slimes[2].growth).toBeNil()
		stored.slimes[1].growth = -3
		expect(SaveData.deserialize(stored).slimes[1].growth).toBeNil()
	end)
end)

describe("Growth percent", function()
	it("a half-grown slime is at 50% and scales to match", function()
		local s = Fixtures.slime("a", 2, { growth = 0.5 })
		expect(Growth.percent(s)).toBe(50)
		expect(approx(Growth.scaleAt(0.5), Growth.scale(s))).toBe(true)
	end)
	it("rises with growth, whole percents only", function()
		local s = Fixtures.slime("a", 2)
		expect(Growth.percent(s)).toBe(0)
		Growth.advance(s, Config.GROWTH_SECONDS * 0.071)
		expect(Growth.percent(s)).toBe(7)
		Growth.advance(s, Config.GROWTH_SECONDS * 0.0049)
		expect(Growth.percent(s)).toBe(8)
		Growth.advance(s, Config.GROWTH_SECONDS)
		expect(Growth.percent(s)).toBe(100)
	end)
	it("scaleAt and percentAt treat garbage as 0 and clamp", function()
		expect(Growth.scaleAt(0 / 0)).toBe(1)
		expect(approx(Growth.scaleAt(5), 1 + Config.GROWTH_MAX_SCALE_BONUS)).toBe(true)
		expect(Growth.percentAt(-1)).toBe(0)
		expect(Growth.percentAt(0.504)).toBe(50)
	end)
	it("sits the label above the highest part, never inside the slime", function()
		expect(Growth.labelOffset(2)).toBe(2 + Config.GROWTH_LABEL_GAP)
		expect(Growth.labelOffset(-3)).toBe(Config.GROWTH_LABEL_GAP)
	end)
end)
