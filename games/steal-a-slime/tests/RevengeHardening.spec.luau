--!strict
-- Revenge hardening (FEATURES.Revenge, CONTRACT.md §16): the first-Studio-run cases the feature
-- spec does not cover. Config.FEATURES is frozen, so every check asserts both modes of the flag
-- (tests/FeatureFlags.spec runs this file with the flag flipped). Cloud-eligible: no Lune modules.
local Carry = require("../src/server/Carry")
local Config = require("../src/shared/Config")
local Economy = require("../src/shared/Economy")
local Fixtures = require("./Fixtures")
local PlotPrompts = require("../src/server/PlotPrompts")
local Revenge = require("../src/server/Revenge")
local RevengePlots = require("../src/shared/RevengePlots")
local SaveData = require("../src/shared/SaveData")
local ServerFixtures = require("./ServerFixtures")
local Sessions = require("../src/server/Sessions")
local Snapshot = require("../src/server/Snapshot")
local StealService = require("../src/server/StealService")
local TestRunner = require("./TestRunner")
local World = require("../src/server/World")

local describe, it, expect = TestRunner.describe, TestRunner.it, TestRunner.expect
local T0 = ServerFixtures.T0
local LATER = T0 + 1000 -- join locks long gone
local WINDOW = Config.REVENGE_SECONDS
local on = Config.FEATURES.Revenge == true

local function setup()
	local world = ServerFixtures.world()
	local victim = ServerFixtures.join(world, 1, { Fixtures.slime("gem1", 4), Fixtures.slime("gem1b", 4) })
	local thief = ServerFixtures.join(world, 2, nil, 1e12)
	ServerFixtures.unlock(victim)
	ServerFixtures.unlock(thief)
	return world, victim, thief
end

local function rob(world: World.World, slimeId: string, now: number)
	expect((Carry.grab(world, 2, slimeId, 1, now))).toBe(true)
	expect((Carry.deposit(world, 2, now))).toBe(true)
end

describe("Revenge flag", function()
	it("opens a window only with the flag on, and robbing works either way", function()
		local world, victim = setup()
		rob(world, "gem1", LATER)
		expect(Revenge.isActive(world, 1, 2, LATER)).toBe(on)
		expect(world.revenge[1] ~= nil).toBe(on)
		expect(#Revenge.plotsFor(world, 1, LATER)).toBe(if on then 1 else 0)
		expect(Revenge.lockMultiplier(world, 2, LATER)).toBe(if on then Config.REVENGE_LOCK_COST_MULT else 1)
		expect(#victim.data.slimes).toBe(1) -- the theft itself is not gated
	end)
	it("charges the thief the shown lock price (State, plot prompt and purchase agree)", function()
		local world, _, thief = setup()
		rob(world, "gem1", LATER)
		local base = Economy.lockCost(World.incomeOf(world, thief))
		local mult = if on then Config.REVENGE_LOCK_COST_MULT else 1
		local state = Snapshot.build(world, thief, LATER)
		expect(state.lockCost).toBe(base * mult)
		expect(PlotPrompts.describe(world, thief.plotIndex, LATER).lockCost).toBe(base * mult)
		local before = thief.data.cash
		expect((StealService.buyLock(world, thief, LATER))).toBe(true)
		expect(before - thief.data.cash).toBe(base * mult)
	end)
	it("a thief who cannot afford the x2 price is refused and pays nothing", function()
		if not on then
			return
		end
		local world, _, thief = setup()
		rob(world, "gem1", LATER)
		local base = Economy.lockCost(World.incomeOf(world, thief))
		thief.data.cash = base * Config.REVENGE_LOCK_COST_MULT - 1
		local ok = StealService.buyLock(world, thief, LATER)
		expect(ok).toBe(false)
		expect(thief.data.cash).toBe(base * Config.REVENGE_LOCK_COST_MULT - 1)
		expect(thief.lockUntil).toBe(0)
		thief.data.cash = base * Config.REVENGE_LOCK_COST_MULT
		expect((StealService.buyLock(world, thief, LATER))).toBe(true)
		expect(thief.data.cash).toBe(0)
	end)
end)

describe("Revenge on a fresh world and bad input", function()
	it("is inert with no marks: prune, forget and queries on unknown ids never error", function()
		local world = ServerFixtures.world()
		expect(next(world.revenge)).toBeNil()
		Revenge.prune(world, T0)
		Revenge.forget(world, 12345)
		expect(Revenge.isActive(world, 1, 2, T0)).toBe(false)
		expect(Revenge.lockMultiplier(world, 2, T0)).toBe(1)
		expect(#Revenge.plotsFor(world, 1, T0)).toBe(0)
		expect(next(world.revenge)).toBeNil()
	end)
	it("never marks a player against themselves", function()
		local world = ServerFixtures.world()
		Revenge.mark(world, 5, 5, T0)
		expect(next(world.revenge)).toBeNil()
	end)
	it("a mark for a victim who is not in the server expires without touching a missing session", function()
		local world = ServerFixtures.world()
		Revenge.mark(world, 77, 88, T0) -- neither joined
		Revenge.prune(world, T0 + WINDOW + 1) -- World.markDirty(nil) must be safe
		expect(next(world.revenge)).toBeNil()
	end)
	it("prune and forget are idempotent", function()
		local world = setup()
		rob(world, "gem1", LATER)
		Revenge.prune(world, LATER + WINDOW + 5)
		Revenge.prune(world, LATER + WINDOW + 5)
		Revenge.forget(world, 2)
		Revenge.forget(world, 2)
		expect(next(world.revenge)).toBeNil()
	end)
	it("a window opened by a float clock expires on the float boundary", function()
		local world = ServerFixtures.world()
		ServerFixtures.join(world, 1)
		ServerFixtures.join(world, 2)
		Revenge.mark(world, 1, 2, LATER + 0.25)
		expect(Revenge.isActive(world, 1, 2, LATER + WINDOW + 0.2499)).toBe(on)
		expect(Revenge.isActive(world, 1, 2, LATER + WINDOW + 0.25)).toBe(false)
	end)
	it("lists several thieves' plots in ascending order", function()
		local world = ServerFixtures.world()
		ServerFixtures.join(world, 1)
		local a = ServerFixtures.join(world, 2)
		local b = ServerFixtures.join(world, 3)
		local c = ServerFixtures.join(world, 4)
		Revenge.mark(world, 1, 4, T0)
		Revenge.mark(world, 1, 2, T0)
		Revenge.mark(world, 1, 3, T0)
		local plots = Revenge.plotsFor(world, 1, T0)
		expect(#plots).toBe(if on then 3 else 0)
		if on then
			expect(plots[1] < plots[2] and plots[2] < plots[3]).toBe(true)
			expect(RevengePlots.format(plots)).toBe(`{a.plotIndex},{b.plotIndex},{c.plotIndex}`)
		end
	end)
	it("the wire format survives huge, fractional and hostile attribute values", function()
		local parsed = RevengePlots.parse("nan,inf,0x,--1,1e2,  7 ")
		for _, n in parsed do
			expect(n == n and n >= 1).toBe(true)
		end
		expect(table.find(parsed, 100) ~= nil and table.find(parsed, 7) ~= nil).toBe(true)
		RevengePlots.parse(string.rep("1,", 5000))
		expect(RevengePlots.format({ 2.9 })).toBe("2")
	end)
end)

describe("Revenge players leaving mid-steal", function()
	it("the victim leaving while the thief carries opens no window", function()
		local world = setup()
		expect((Carry.grab(world, 2, "gem1", 1, LATER))).toBe(true)
		Sessions.leave(world, 1, LATER + 1)
		local ok = Carry.deposit(world, 2, LATER + 2)
		expect(ok).toBe(false) -- nothing carried any more
		expect(next(world.revenge)).toBeNil()
		expect(Revenge.lockMultiplier(world, 2, LATER + 2)).toBe(1)
	end)
	it("the thief leaving while carrying opens no window", function()
		local world = setup()
		expect((Carry.grab(world, 2, "gem1", 1, LATER))).toBe(true)
		Sessions.leave(world, 2, LATER + 1)
		expect(next(world.revenge)).toBeNil()
	end)
	it("leaving and rejoining the same id in a later window does not revive the old one", function()
		local world = setup()
		rob(world, "gem1", LATER)
		Sessions.leave(world, 1, LATER + 1)
		ServerFixtures.join(world, 1, nil, nil, LATER + 2)
		expect(Revenge.lockMultiplier(world, 2, LATER + 3)).toBe(1)
		expect(#Revenge.plotsFor(world, 1, LATER + 3)).toBe(0)
	end)
end)

describe("Revenge with old and fresh saves", function()
	it("needs no save field: an empty stored save joins, snapshots and robs", function()
		local data = SaveData.deserialize({})
		local world = ServerFixtures.world()
		local session = Sessions.join(world, 9, "P9", data, T0)
		assert(session, "join")
		expect(Snapshot.build(world, session, T0 + 1).lockCost > 0).toBe(true)
		expect(Revenge.lockMultiplier(world, 9, T0 + 1)).toBe(1)
	end)
	it("never writes revenge state into a save", function()
		local world, victim = setup()
		rob(world, "gem1", LATER)
		local stored = SaveData.serialize(victim.data, LATER)
		for key in stored do
			expect(string.find(string.lower(tostring(key)), "revenge", 1, true)).toBeNil()
		end
	end)
end)
