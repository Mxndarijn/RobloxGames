--!strict
local Carry = require("../src/server/Carry")
local Config = require("../src/shared/Config")
local Fixtures = require("./Fixtures")
local PlayerData = require("../src/shared/PlayerData")
local ServerFixtures = require("./ServerFixtures")
local Spawner = require("../src/server/Spawner")
local TestRunner = require("./TestRunner")

local describe, it, expect = TestRunner.describe, TestRunner.it, TestRunner.expect
local T0 = ServerFixtures.T0

local function wildWithPrice(world: any, price: number): string
	local id = Spawner.spawnOne(world, T0)
	world.wild[id].price = price
	return id
end

describe("Carry.grab (wild)", function()
	it("grabs a free slime and marks it carried", function()
		local world = ServerFixtures.world()
		local s = ServerFixtures.join(world, 1, nil, 0)
		local id = wildWithPrice(world, 0)
		local ok = Carry.grab(world, 1, id, 5, T0)
		expect(ok).toBe(true)
		expect(s.carry and s.carry.slimeId).toBe(id)
		expect(s.carry and s.carry.kind).toBe("wild")
		expect(world.carriedBy[id]).toBe(1)
	end)
	it("charges the price on grab and refuses when broke", function()
		local world = ServerFixtures.world()
		local s = ServerFixtures.join(world, 1, nil, 50)
		local id = wildWithPrice(world, 80)
		local ok, reason = Carry.grab(world, 1, id, 5, T0)
		expect(ok).toBe(false)
		expect(reason).toBe("need $80")
		expect(s.data.cash).toBe(50)
		s.data.cash = 100
		expect((Carry.grab(world, 1, id, 5, T0))).toBe(true)
		expect(s.data.cash).toBe(20)
		expect(world.wild[id].price).toBe(0)
	end)
	it("refuses a paid slime before charging when the plot has no free pad", function()
		local world = ServerFixtures.world()
		local slimes = {}
		for i = 1, Config.PADS_MAX do
			slimes[i] = Fixtures.slime(`p{i}`)
		end
		local s = ServerFixtures.join(world, 1, slimes, 500)
		local id = wildWithPrice(world, 80)
		local ok, reason = Carry.grab(world, 1, id, 5, T0)
		expect(ok).toBe(false)
		expect(reason).toBe("plot full")
		expect(s.data.cash).toBe(500)
		expect(s.carry).toBeNil()
		expect(world.carriedBy[id]).toBeNil()
		expect(world.wild[id].price).toBe(80)
	end)
	it("enforces reach, one carry at a time and one carrier per slime", function()
		local world = ServerFixtures.world()
		ServerFixtures.join(world, 1)
		ServerFixtures.join(world, 2)
		local a, b = wildWithPrice(world, 0), wildWithPrice(world, 0)
		expect(select(2, Carry.grab(world, 1, a, Config.STEAL_REACH + 1, T0))).toBe("too far away")
		expect(select(2, Carry.grab(world, 1, a, 0 / 0, T0))).toBe("too far away")
		expect((Carry.grab(world, 1, a, 1, T0))).toBe(true)
		expect(select(2, Carry.grab(world, 1, b, 1, T0))).toBe("already carrying a slime")
		expect(select(2, Carry.grab(world, 2, a, 1, T0))).toBe("someone is already carrying it")
		expect(select(2, Carry.grab(world, 3, b, 1, T0))).toBe("still loading")
		expect(select(2, Carry.grab(world, 2, "nope", 1, T0))).toBe("slime is gone")
	end)
	it("prompt text is Grab / Buy $<price> / Steal", function()
		expect(Carry.actionText(0)).toBe("Grab")
		expect(Carry.actionText(1500)).toBe("Buy $1.5K")
		expect(Carry.actionText(nil)).toBe("Steal")
	end)
end)

describe("Carry.deposit", function()
	it("puts a wild slime on the first free pad and removes it from the wild", function()
		local world = ServerFixtures.world()
		local s = ServerFixtures.join(world, 1, { Fixtures.slime("own") })
		local id = wildWithPrice(world, 0)
		Carry.grab(world, 1, id, 1, T0)
		expect((Carry.deposit(world, 1))).toBe(true)
		expect(s.carry).toBeNil()
		expect(world.wild[id]).toBeNil()
		expect(world.carriedBy[id]).toBeNil()
		local slime = PlayerData.findSlime(s.data, id)
		expect(slime and slime.pad).toBe(2)
	end)
	it("keeps carrying when the plot is full", function()
		local world = ServerFixtures.world()
		local slimes = {}
		for i = 1, Config.PADS_MAX do
			slimes[i] = Fixtures.slime(`p{i}`)
		end
		local s = ServerFixtures.join(world, 1, slimes)
		local id = wildWithPrice(world, 0)
		Carry.grab(world, 1, id, 1, T0)
		local ok, reason = Carry.deposit(world, 1)
		expect(ok).toBe(false)
		expect(reason).toBe("plot full")
		expect(s.carry and s.carry.slimeId).toBe(id)
	end)
	it("fails when not carrying", function()
		local world = ServerFixtures.world()
		ServerFixtures.join(world, 1)
		expect(select(2, Carry.deposit(world, 1))).toBe("not carrying")
	end)
end)

describe("Carry.release", function()
	it("drops a wild slime where the carrier stood with a fresh lifetime", function()
		local world = ServerFixtures.world()
		local s = ServerFixtures.join(world, 1)
		local id = wildWithPrice(world, 0)
		Carry.grab(world, 1, id, 1, T0)
		expect(Carry.release(world, 1, T0 + 50, "here", "drop")).toBe(true)
		expect(s.carry).toBeNil()
		expect(world.carriedBy[id]).toBeNil()
		expect(world.wild[id].position).toBe("here")
		expect(world.wild[id].expiresAt).toBe(T0 + 50 + Config.WILD_LIFETIME)
		expect(Carry.release(world, 1, T0, nil, "drop")).toBe(false)
	end)
	it("cancelMissing ends carries of slimes that no longer exist", function()
		local world = ServerFixtures.world()
		local s = ServerFixtures.join(world, 1)
		local id = wildWithPrice(world, 0)
		Carry.grab(world, 1, id, 1, T0)
		world.wild[id] = nil
		Carry.cancelMissing(world)
		expect(s.carry).toBeNil()
		expect(world.carriedBy[id]).toBeNil()
	end)
	it("walkSpeed is base when empty-handed and slower while carrying", function()
		local world = ServerFixtures.world()
		local s = ServerFixtures.join(world, 1)
		expect(Carry.walkSpeed(s)).toBe(Config.BASE_WALK_SPEED)
		local id = wildWithPrice(world, 0)
		Carry.grab(world, 1, id, 1, T0)
		expect(Carry.walkSpeed(s) < Config.BASE_WALK_SPEED).toBeTruthy()
	end)
end)

describe("Speed Coil (CONTRACT.md §8.10)", function()
	local Actions = require("../src/server/Actions")
	local ctx = {
		distanceBetween = function()
			return 0
		end,
		positionOf = function()
			return nil
		end,
	}
	it("buying it raises the enforced WalkSpeed from base to the coil speed", function()
		local world = ServerFixtures.world()
		local s = ServerFixtures.join(world, 1, nil, Config.SPEED_COIL_PRICE)
		expect(Carry.targetWalkSpeed(s, T0)).toBe(Config.BASE_WALK_SPEED)
		local res = Actions.handle(world, 1, "BuySpeedCoil", {}, T0, ctx)
		expect(res.ok).toBe(true)
		expect(s.data.speedCoil).toBe(true)
		expect(Carry.targetWalkSpeed(s, T0)).toBe(Config.SPEED_COIL_WALK_SPEED)
	end)
	it("still helps while carrying (v12 ignored it)", function()
		local world = ServerFixtures.world()
		local plain = ServerFixtures.join(world, 1)
		local coil = ServerFixtures.join(world, 2)
		coil.data.speedCoil = true
		local a, b = wildWithPrice(world, 0), wildWithPrice(world, 0)
		world.wild[a].slime.tier = 3
		world.wild[b].slime.tier = 3
		expect((Carry.grab(world, 1, a, 1, T0))).toBe(true)
		expect((Carry.grab(world, 2, b, 1, T0))).toBe(true)
		local slow, fast = Carry.targetWalkSpeed(plain, T0), Carry.targetWalkSpeed(coil, T0)
		expect(slow < Config.BASE_WALK_SPEED).toBe(true)
		expect(fast < Config.SPEED_COIL_WALK_SPEED).toBe(true)
		expect(fast / slow).toBeCloseTo(Config.SPEED_COIL_WALK_SPEED / Config.BASE_WALK_SPEED, 1e-6)
	end)
end)
