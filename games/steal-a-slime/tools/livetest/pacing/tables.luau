--!strict
--[[
	Static economy tables straight from the real modules (Config, Economy, Upgrades, Shop, Consumables,
	EggKind / MysteryEgg, Codes, FriendBonus, Perks, Steal), no simulation except the Mystery Egg Monte Carlo.

	  lune run tools/livetest/pacing/tables [--out tables.md] [--json tables.json] [--eggs 150000]
]]

local fs = require("@lune/fs")
local process = require("@lune/process")
local serde = require("@lune/serde")

local Config = require("../../../src/shared/Config")
local Economy = require("../../../src/shared/Economy")
local EggKind = require("../../../src/shared/EggKind")
local Eggs = require("./Eggs")
local FriendBonus = require("../../../src/shared/FriendBonus")
local Genome = require("../../../src/shared/Genome")
local Perks = require("../../../src/shared/Perks")
local PvpRules = require("../../../src/shared/PvpRules")
local SlimeRoster = require("../../../src/shared/SlimeRoster")
local Steal = require("../../../src/shared/Steal")
local Upgrades = require("../../../src/shared/Upgrades")

local args = process.args
local outPath, jsonPath, eggCount = nil :: string?, nil :: string?, 150000
for i = 1, #args, 2 do
	if args[i] == "--out" then
		outPath = args[i + 1]
	elseif args[i] == "--json" then
		jsonPath = args[i + 1]
	elseif args[i] == "--eggs" then
		eggCount = tonumber(args[i + 1]) or eggCount
	end
end

local lines: { string } = {}
local json: { [string]: any } = {}

local function money(n: number): string
	return "$" .. Economy.formatNumber(math.floor(n))
end

local function pct(x: number): string
	return string.format("%.1f%%", x * 100)
end

local function num(x: number): string
	return if x == math.floor(x) then tostring(x) else string.format("%.2f", x)
end

local function add(text: string)
	table.insert(lines, text)
end

local function render(title: string, key: string, header: { string }, rows: { { string } }, raw: any?)
	add(`## {title}`)
	add("")
	add("| " .. table.concat(header, " | ") .. " |")
	add("|" .. string.rep("---|", #header))
	for _, row in rows do
		add("| " .. table.concat(row, " | ") .. " |")
	end
	add("")
	json[key] = raw
end

-- Mean wild size: MIN_SIZE + up to 0.6, never under the tier's floor (Genome.generate).
local function meanWildSize(tier: number): number
	return math.max(Config.MIN_SIZE + 0.3, Genome.sizeFloor(tier))
end

add("# Steal a Slime economy tables")
add("")
add("Generated by `lune run tools/livetest/pacing/tables` from the live Config / Economy / EggKind modules.")
add("")

-- 1. Pads ------------------------------------------------------------------------------------------------------
do
	local rows, raw = {}, {}
	local cumulative = 0
	for owned = Config.PADS_START, Config.PADS_MAX - 1 do
		local cost = Economy.padCost(owned) :: number
		cumulative += cost
		local nextCost = Economy.padCost(owned + 1)
		table.insert(rows, {
			tostring(owned + 1),
			tostring(Economy.floorOf(owned + 1)),
			money(cost),
			money(cumulative),
			if nextCost then string.format("x%.2f", nextCost / cost) else "-",
		})
		table.insert(raw, { pad = owned + 1, floor = Economy.floorOf(owned + 1), cost = cost, cumulative = cumulative })
	end
	render("Pads", "pads", { "Pad", "Floor", "Price", "Cumulative", "Next / this" }, rows, raw)
end

-- 2. Upgrades, Speed Coil, consumables, PvP --------------------------------------------------------------------
do
	local rows, raw = {}, {}
	for _, def in Config.UPGRADES do
		local cumulative = 0
		for level = 0, def.maxLevel - 1 do
			local cost = Upgrades.cost(def.id, level) :: number
			cumulative += cost
			table.insert(rows, {
				def.id,
				def.name,
				tostring(level + 1),
				tostring(def.requires),
				money(cost),
				money(cumulative),
				def.text,
			})
			table.insert(
				raw,
				{ id = def.id, level = level + 1, requires = def.requires, cost = cost, cumulative = cumulative }
			)
		end
	end
	table.insert(
		rows,
		{ "SpeedCoil", "Speed Coil", "1", "0", money(Config.SPEED_COIL_PRICE), "-", "WalkSpeed 16 -> 24" }
	)
	render(
		"Upgrades and Speed Coil",
		"upgrades",
		{ "Id", "Name", "Level", "Needs rebirths", "Price", "Cumulative", "Effect" },
		rows,
		raw
	)

	local crows, craw = {}, {}
	for _, def in Config.CONSUMABLES do
		for _, r in { 0, 5, 10, 20 } do
			local price = math.floor(def.price * Economy.rebirthMultiplier(r))
			table.insert(crows, {
				def.id,
				tostring(r),
				money(price),
				`{def.minStock}-{def.maxStock} per {Config.CONSUMABLES_RESTOCK_SECONDS // 60} min`,
				def.text,
			})
			table.insert(craw, { id = def.id, rebirths = r, price = price })
		end
	end
	render(
		"Consumables (price x rebirth multiplier)",
		"consumables",
		{ "Item", "Rebirths", "Price", "Stock", "Text" },
		crows,
		craw
	)

	local prows, praw = {}, {}
	for _, tool in Config.PVP_TOOLS do
		local price = PvpRules.price(tool.id)
		table.insert(
			prows,
			{ tool.id, tool.name, tostring(tool.rebirths), money(price), money(Economy.rebirthCost(tool.rebirths)) }
		)
		table.insert(praw, { id = tool.id, gate = tool.rebirths, price = price })
	end
	render(
		"PvP items (price = factor x rebirth cost of the gate)",
		"pvp",
		{ "Id", "Name", "Rebirths", "Price", "Rebirth cost at the gate" },
		prows,
		praw
	)
end

-- 3. Rebirths ---------------------------------------------------------------------------------------------------
do
	local rows, raw = {}, {}
	for r = 0, Config.MAX_REBIRTHS - 1 do
		local cost = Economy.rebirthCost(r)
		local nextCost = Economy.rebirthCost(r + 1)
		local before = Economy.rebirthMultiplier(r) * (1 + Perks.rankIncomeBonus(r))
		local after = Economy.rebirthMultiplier(r + 1) * (1 + Perks.rankIncomeBonus(r + 1))
		local names = {}
		local needs = {}
		for _, id in Config.REBIRTH_SLIMES[r + 1] or {} do
			local entry = SlimeRoster.get(id)
			table.insert(
				names,
				if entry then `{entry.name} (T{entry.tier}{if entry.kind == "hybrid" then " hybrid" else ""})` else id
			)
			table.insert(needs, id)
		end
		local tier = Perks.tier(r + 1)
		table.insert(rows, {
			tostring(r + 1),
			money(cost),
			string.format("x%.2f", nextCost / cost),
			string.format("x%.2f", Economy.rebirthMultiplier(r + 1)),
			string.format("x%.2f", after / before),
			string.format("x%.2f", (nextCost / cost) / (after / before)),
			tostring(Steal.lockDuration(r + 1)),
			tier.title,
			table.concat(names, ", "),
		})
		table.insert(raw, {
			rebirth = r + 1,
			cost = cost,
			costGrowth = nextCost / cost,
			multiplier = Economy.rebirthMultiplier(r + 1),
			totalMultiplier = after,
			incomeStep = after / before,
			lockSeconds = Steal.lockDuration(r + 1),
			rank = tier.title,
			needs = needs,
		})
	end
	render(
		"Rebirths (rebirth N costs the price at N-1; Wall = how much more income the next rebirth needs than this one gave)",
		"rebirths",
		{
			"Rebirth",
			"Cost",
			"Next cost",
			"Multiplier after",
			"Income step (rank bonus incl.)",
			"Wall (next cost growth / income step this rebirth gives)",
			"Lock s",
			"Rank",
			"Uses up",
		},
		rows,
		raw
	)
end

-- 4. Locks --------------------------------------------------------------------------------------------------------
do
	local rows, raw = {}, {}
	for _, income in { 10, 100, 1e3, 1e4, 1e5, 1e6, 1e7, 1e8 } do
		local cost = Economy.lockCost(income)
		local row = { money(income) .. "/s", money(cost) }
		for _, r in { 0, 5, 10, 20 } do
			table.insert(row, `{Steal.lockDuration(r)}s`)
		end
		table.insert(rows, row)
		table.insert(raw, { income = income, cost = cost })
	end
	render(
		`Lock (cost = max({Config.LOCK_BASE_COST}, income x {Config.LOCK_INCOME_SECONDS} s); join lock {Config.JOIN_LOCK_SECONDS}s; max stack {Config.LOCK_MAX_REMAINING}s)`,
		"locks",
		{ "Plot income", "Lock price", "Length r=0", "r=5", "r=10", "r=20" },
		rows,
		raw
	)
end

-- 5. Slimes ---------------------------------------------------------------------------------------------------------
do
	local total = 0
	for _, r in Config.RARITIES do
		total += r.weight
	end
	local rows, raw = {}, {}
	for _, r in Config.RARITIES do
		local size = meanWildSize(r.tier)
		local base = r.income * size
		local species = #SlimeRoster.forTier(r.tier)
		local families = 0
		for _, entry in SlimeRoster.ROSTER do
			if entry.kind == "spawn" and entry.tier == r.tier then
				families += 1
			end
		end
		table.insert(rows, {
			r.name,
			num(r.income),
			num(size),
			money(base),
			money(base * Config.WILD_PRICE_SECONDS),
			money(base * Config.SELL_SECONDS),
			string.format("x%.2f", Config.SELL_SECONDS / Config.WILD_PRICE_SECONDS),
			pct(r.weight / total),
			string.format("1 in %.0f", total / r.weight),
			`{families} ({species} Classic)`,
		})
		table.insert(raw, {
			tier = r.tier,
			name = r.name,
			income = r.income,
			meanSize = size,
			baseIncome = base,
			wildPrice = base * Config.WILD_PRICE_SECONDS,
			sell = base * Config.SELL_SECONDS,
			share = r.weight / total,
			species = families,
		})
	end
	render(
		"Slimes by rarity (mean wild size, growth 0, 0 rebirths; sell is x rebirth multiplier)",
		"rarities",
		{
			"Rarity",
			"Income/s at size 1",
			"Mean size",
			"Mean income/s",
			"Wild price",
			"Sell at r=0",
			"Sell / price at r=0",
			"Drop share",
			"Odds",
			"Spawning species",
		},
		rows,
		raw
	)

	local frows, fraw = {}, {}
	for _, r in { 0, 1, 3, 5, 10, 15, 20, 30, 49 } do
		local m = Economy.rebirthMultiplier(r)
		table.insert(
			frows,
			{
				tostring(r),
				string.format("x%.1f", m),
				string.format("x%.2f", Config.SELL_SECONDS * m / Config.WILD_PRICE_SECONDS),
			}
		)
		table.insert(
			fraw,
			{ rebirths = r, multiplier = m, sellOverPrice = Config.SELL_SECONDS * m / Config.WILD_PRICE_SECONDS }
		)
	end
	render(
		"Buy a wild slime, sell it at once (flip): sell price / grab price grows with the rebirth multiplier",
		"flip",
		{ "Rebirths", "Rebirth multiplier", "Sell / grab price (growth 0)" },
		frows,
		fraw
	)

	local srows, sraw = {}, {}
	for _, entry in SlimeRoster.ROSTER do
		local rarity = Genome.rarity(entry.tier)
		local size = if entry.kind == "boss" then Config.MAX_SIZE else meanWildSize(entry.tier)
		table.insert(srows, {
			entry.id,
			entry.name,
			tostring(entry.tier),
			entry.kind,
			entry.family or "classic",
			money(rarity.income * size),
		})
		table.insert(
			sraw,
			{ id = entry.id, tier = entry.tier, kind = entry.kind, family = entry.family, income = rarity.income * size }
		)
	end
	render(
		"Species (mean wild size, boss at MAX_SIZE)",
		"species",
		{ "Id", "Name", "Tier", "Kind", "Family", "Income/s" },
		srows,
		sraw
	)
end

-- 6. Mystery Eggs ---------------------------------------------------------------------------------------------------
do
	local outcomes = Eggs.simulate(eggCount, 7)
	local weightTotal = 0
	for _, kind in EggKind.list() do
		weightTotal += kind.weight
	end
	local rows, raw = {}, {}
	local evByRebirth: { [number]: { profit: number, sell: number } } = {}
	for _, kind in EggKind.list() do
		local out = outcomes[kind.id]
		local analytic = Eggs.expectedIncome(kind)
		local row = {
			kind.name,
			money(kind.price),
			money(kind.sell),
			`{kind.hatchSeconds // 60} min`,
			pct(kind.weight / weightTotal),
			`{kind.pity}`,
			money(analytic),
			money(out.income),
			pct(out.topShare),
			pct(out.guaranteed),
		}
		local tierText = {}
		local tierShares = {}
		for tier = 1, Config.MAX_TIER do
			if out.tiers[tier] then
				table.insert(tierText, `{Genome.rarity(tier).name} {pct(out.tiers[tier])}`)
				tierShares[tostring(tier)] = out.tiers[tier]
			end
		end
		table.insert(row, table.concat(tierText, ", "))
		table.insert(rows, row)
		table.insert(raw, {
			id = kind.id,
			price = kind.price,
			sell = kind.sell,
			hatchSeconds = kind.hatchSeconds,
			weight = kind.weight / weightTotal,
			pity = kind.pity,
			analyticIncome = analytic,
			simIncome = out.income,
			topShare = out.topShare,
			guaranteed = out.guaranteed,
			tiers = tierShares,
			n = out.n,
		})
	end
	render(
		`Mystery Egg kinds ({Config.MYSTERY_EGG.DROP_CHANCE * 100}% of fountain drops, {Config.MYSTERY_EGG.MAX_WILD} loose at a time, lucky egg {Config.MYSTERY_EGG.LUCKY_CHANCE * 100}%; Monte Carlo of {eggCount} hatches through MysteryEgg.rollWild / hatchEgg)`,
		"eggs",
		{
			"Kind",
			"Grab price",
			"Sell (egg)",
			"Incubation",
			"Share of eggs",
			"Lucky meter",
			"Mean income/s (formula)",
			"Mean income/s (sim)",
			"Top tier",
			"From full meter",
			"Hatches into",
		},
		rows,
		raw
	)

	-- What a hatched egg is worth against its price, by rebirth: sell of the mean hatchling vs the flat grab price.
	local erows, eraw = {}, {}
	for _, r in { 0, 3, 5, 10, 20 } do
		local mult = Economy.rebirthMultiplier(r)
		local row = { tostring(r) }
		local weightedProfit, weightedPrice = 0, 0
		for _, kind in EggKind.list() do
			local out = outcomes[kind.id]
			local sellHatch = out.income * Config.SELL_SECONDS * mult
			local share = kind.weight / weightTotal
			weightedProfit += share * (sellHatch - kind.price)
			weightedPrice += share * kind.price
			table.insert(row, `{money(sellHatch)} ({string.format("x%.1f", sellHatch / kind.price)})`)
		end
		table.insert(row, money(weightedProfit))
		table.insert(erows, row)
		table.insert(eraw, { rebirths = r, meanProfit = weightedProfit, meanPrice = weightedPrice })
		evByRebirth[r] = { profit = weightedProfit, sell = weightedProfit + weightedPrice }
	end
	local header = { "Rebirths" }
	for _, kind in EggKind.list() do
		table.insert(header, `{kind.name}: sell of hatchling (x price)`)
	end
	table.insert(header, "Mean profit per egg grabbed")
	render("Egg flip: sell value of the hatched slime against the flat grab price", "eggFlip", header, erows, eraw)
end

-- 7. Codes, friends, dailies, goals ---------------------------------------------------------------------------------
do
	local rows, raw = {}, {}
	local ids = {}
	for code in Config.CODES do
		table.insert(ids, code)
	end
	table.sort(ids)
	for _, code in ids do
		local def = (Config.CODES :: any)[code]
		local reward = def.reward
		local what = if reward.kind == "cash"
			then money(reward.amount)
			else `{reward.mult}x income for {reward.minutes} min`
		table.insert(rows, {
			code,
			what,
			if def.expiresAt then os.date("!%Y-%m-%d", def.expiresAt) else "never",
			if reward.kind == "cash"
				then string.format("%.2f%%", reward.amount / Economy.rebirthCost(0) * 100)
				else "-",
		})
		table.insert(
			raw,
			{ code = code, kind = reward.kind, amount = reward.amount, mult = reward.mult, minutes = reward.minutes }
		)
	end
	render(
		"Redeem codes (cash is NOT scaled by rebirths)",
		"codes",
		{ "Code", "Reward", "Expires", "Share of rebirth 1 cost" },
		rows,
		raw
	)

	local frows, fraw = {}, {}
	for n = 0, FriendBonus.maxFriends() + 1 do
		table.insert(frows, { tostring(n), pct(FriendBonus.bonus(n)) })
		table.insert(fraw, { friends = n, bonus = FriendBonus.bonus(n) })
	end
	render(
		`Friend bonus (+{Config.FRIEND_BONUS_PER_FRIEND * 100}% per friend in the same server, cap {Config.FRIEND_BONUS_CAP * 100}%)`,
		"friends",
		{ "Friends in server", "Income bonus" },
		frows,
		fraw
	)

	local drows, draw = {}, {}
	for _, r in { 0, 5, 10, 20 } do
		local m = Economy.rebirthMultiplier(r)
		local goalTotal = 0
		for _, goal in Config.GOALS do
			for _, reward in goal.rewards do
				goalTotal += reward * m
			end
		end
		local questMax = 0
		for _, q in Config.DAILY_QUESTS.pool do
			if q.reward.kind == "cash" then
				questMax = math.max(questMax, (q.reward.amount or 0) * m)
			end
		end
		table.insert(drows, {
			tostring(r),
			money(Economy.rebirthCost(r)),
			money(Config.DAILY_BASE * Config.DAILY_STREAK_CAP * m),
			money(questMax * Config.DAILY_QUESTS.count),
			money(goalTotal),
		})
		table.insert(draw, {
			rebirths = r,
			rebirthCost = Economy.rebirthCost(r),
			dailyMax = Config.DAILY_BASE * Config.DAILY_STREAK_CAP * m,
			questsMax = questMax * Config.DAILY_QUESTS.count,
			goalsTotal = goalTotal,
		})
	end
	render(
		"Daily, quests and goals (cash x rebirth multiplier) against the rebirth price",
		"rewards",
		{ "Rebirths", "Rebirth price", "Daily at 7-day streak", "3 best quests (cash)", "All goal stages ever" },
		drows,
		draw
	)
end

-- 8. Multipliers ----------------------------------------------------------------------------------------------------
do
	local incomeMax = (1 + Config.UPGRADES[1].maxLevel * Config.UPGRADES[1].step)
	local rank = 0
	for _, tier in Config.REBIRTH_TIERS do
		rank = math.max(rank, tier.income or 0)
	end
	local dex = 0
	for _, m in Config.DEX_MILESTONES.species do
		dex += m.bonus
	end
	local ritual = Config.RITUAL.BONUS[Config.RITUAL.SPOTS]
	local pet = Config.PET_PASSIVES.KINDS.income.cap
	local codeBoost = 2
	local items = {
		{ "Slime Snacks (Income upgrade, level 10)", incomeMax },
		{ "Rank income bonus (Slime Deity)", 1 + rank },
		{ "SlimeDex ladder", 1 + dex },
		{ "Code boost (SLIMEBOOST / quests, 10-15 min)", codeBoost },
		{ "Friends (3 in server)", 1 + FriendBonus.bonus(3) },
		{ "Co-op ritual (Blessed, 3 min)", 1 + ritual },
		{ "Follow pet (income kind, cap)", 1 + pet },
		{ "x2 Weekend (Sat + Sun UTC)", Config.WEEKEND.multiplier },
		{ "Growth (12 h on a pad)", 1 + Config.GROWTH_MAX_INCOME_BONUS },
	}
	local rows, raw = {}, {}
	local always, everything = 1, 1
	for i, item in items do
		table.insert(rows, { item[1], string.format("x%.2f", item[2]) })
		table.insert(raw, { name = item[1], multiplier = item[2] })
		everything *= item[2]
		if i <= 3 or i == 9 then
			always *= item[2]
		end
	end
	table.insert(rows, { "**Permanent stack** (upgrade x rank x dex x growth)", string.format("x%.2f", always) })
	table.insert(rows, { "**Everything at once**", string.format("x%.2f", everything) })
	render("Income multipliers on top of the rebirth multiplier", "multipliers", { "Source", "Multiplier" }, rows, raw)

	local orows = {
		{ "Offline rate", pct(Config.OFFLINE_RATE) },
		{
			"Offline cap",
			`{Config.OFFLINE_CAP_SECONDS // 3600} h (+1 h per Night Shift level, max {(Config.OFFLINE_CAP_SECONDS + 4 * 3600) // 3600} h)`,
		},
		{
			"Max cash for one offline stretch",
			`= income/s x {Config.OFFLINE_CAP_SECONDS * Config.OFFLINE_RATE / 3600} h (x{(Config.OFFLINE_CAP_SECONDS + 4 * 3600) * Config.OFFLINE_RATE / 3600} h with Night Shift 4)`,
		},
		{ "Growth offline cap", `{Config.GROWTH_OFFLINE_CAP_SECONDS // 3600} h` },
		{
			"Lucky Saturday",
			`luck x{Config.WEEKLY.TRAITS[1].luck} for {Config.WEEKLY.TRAIT_SECONDS // 3600} h at {Config.WEEKLY.TRAIT_START_HOUR}:00 UTC`,
		},
		{
			"Slime Rain",
			`every {Config.RAIN_INTERVAL // 60} min for {Config.RAIN_DURATION // 60} min, luck x{Config.RAIN_LUCK}, spawns 2x`,
		},
		{
			"Luck Potion",
			`luck x{Config.LUCK_POTION_MULT} (cap {Config.SPAWN_LUCK_CAP}) for {Config.LUCK_POTION_SECONDS // 60} min, shared by the whole server`,
		},
		{
			"Lucky Charm (upgrade)",
			`+{Config.UPGRADES[4].step * 100}% per level, max {Config.UPGRADES[4].maxLevel * Config.UPGRADES[4].step * 100}% to bring a slime home one tier higher`,
		},
		{ "Pity", `Epic+ every {Config.PITY_EPIC} drops, Legendary+ every {Config.PITY_LEGENDARY}` },
	}
	local rawO = {}
	local rowsO = {}
	for _, row in orows do
		table.insert(rowsO, row)
		table.insert(rawO, { name = row[1], value = row[2] })
	end
	render("Other economy rules", "rules", { "Rule", "Value" }, rowsO, rawO)
end

local text = table.concat(lines, "\n")
print(text)
if outPath then
	fs.writeFile(outPath, text)
end
if jsonPath then
	fs.writeFile(jsonPath, serde.encode("json", json))
end
