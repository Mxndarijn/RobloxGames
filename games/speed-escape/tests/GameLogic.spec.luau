--!strict
local GameLogic = require("../src/shared/GameLogic")
local TestRunner = require("./TestRunner")

local describe, it, expect = TestRunner.describe, TestRunner.it, TestRunner.expect
local DEFAULT = GameLogic.DEFAULT_CONFIG

describe("clampSpeed", function()
	it("clamps into [baseSpeed, maxSpeed]", function()
		expect(GameLogic.clampSpeed(5)).toBe(DEFAULT.baseSpeed)
		expect(GameLogic.clampSpeed(50)).toBe(50)
		expect(GameLogic.clampSpeed(9999)).toBe(DEFAULT.maxSpeed)
	end)
	it("maps garbage to baseSpeed", function()
		expect(GameLogic.clampSpeed(0 / 0)).toBe(DEFAULT.baseSpeed)
		expect(GameLogic.clampSpeed(math.huge)).toBe(DEFAULT.baseSpeed)
		expect(GameLogic.clampSpeed("fast")).toBe(DEFAULT.baseSpeed)
		expect(GameLogic.clampSpeed(nil)).toBe(DEFAULT.baseSpeed)
	end)
end)

describe("tickSpeed", function()
	it("adds 1 speed per full second of movement", function()
		local speed, t = 16, 0
		for _ = 1, 60 do
			speed, t = GameLogic.tickSpeed(speed, t, 1 / 60, true)
		end
		expect(speed).toBe(17)
		expect(t < 0.01).toBeTruthy()
	end)
	it("does not gain speed while idle", function()
		local speed, t = GameLogic.tickSpeed(20, 0.5, 1, false)
		expect(speed).toBe(20)
		expect(t).toBe(0.5)
	end)
	it("handles large frames", function()
		local speed, t = GameLogic.tickSpeed(16, 0.5, 3, true)
		expect(speed).toBe(19)
		expect(t).toBeCloseTo(0.5)
	end)
	it("is capped at 200", function()
		local speed, t = GameLogic.tickSpeed(199, 0.9, 5, true)
		expect(speed).toBe(200)
		expect(t).toBe(0)
		speed = GameLogic.tickSpeed(speed, t, 10, true)
		expect(speed).toBe(DEFAULT.maxSpeed)
	end)
	it("ignores bad dt and accumulator values", function()
		expect((GameLogic.tickSpeed(30, 0, -1, true))).toBe(30)
		expect((GameLogic.tickSpeed(30, 0, 0 / 0, true))).toBe(30)
		local _, t = GameLogic.tickSpeed(30, 0 / 0, 0.25, true)
		expect(t).toBeCloseTo(0.25)
	end)
	it("respects a custom config", function()
		expect((GameLogic.tickSpeed(10, 0, 2, true, { baseSpeed = 10, speedPerSecond = 5 }))).toBe(20)
	end)
end)

describe("advanceStage", function()
	it("moves forward to a later checkpoint", function()
		expect(GameLogic.advanceStage(1, 3)).toBe(3)
		local _, changed = GameLogic.advanceStage(1, 3)
		expect(changed).toBeTruthy()
	end)
	it("never moves backward or re-triggers", function()
		local stage, changed = GameLogic.advanceStage(4, 2)
		expect(stage).toBe(4)
		expect(changed).toBeFalsy()
		stage, changed = GameLogic.advanceStage(4, 4)
		expect(stage).toBe(4)
		expect(changed).toBeFalsy()
	end)
	it("allows skipping ahead", function()
		expect((GameLogic.advanceStage(1, 6))).toBe(6)
	end)
	it("ignores invalid indices", function()
		local stage, changed = GameLogic.advanceStage(2, nil)
		expect(stage).toBe(2)
		expect(changed).toBeFalsy()
		expect((GameLogic.advanceStage(2, 0 / 0))).toBe(2)
		expect((GameLogic.advanceStage(2, "5"))).toBe(2)
	end)
	it("repairs an invalid current stage", function()
		expect((GameLogic.advanceStage(0 / 0, nil))).toBe(1)
		expect((GameLogic.advanceStage(-3, nil))).toBe(1)
	end)
end)

describe("applyWin", function()
	it("increments wins and resets the stage", function()
		local ok, state = GameLogic.applyWin({ wins = 2, stage = 6 }, 100)
		expect(ok).toBeTruthy()
		expect(state.wins).toBe(3)
		expect(state.stage).toBe(1)
		expect(state.lastWinAt).toBe(100)
	end)
	it("is debounced by winCooldown", function()
		local _, state = GameLogic.applyWin({ wins = 0, stage = 6 }, 10)
		local ok, same = GameLogic.applyWin(state, 10 + DEFAULT.winCooldown / 2)
		expect(ok).toBeFalsy()
		expect(same.wins).toBe(1)
		ok, state = GameLogic.applyWin(state, 10 + DEFAULT.winCooldown)
		expect(ok).toBeTruthy()
		expect(state.wins).toBe(2)
	end)
	it("does not mutate the input", function()
		local input: GameLogic.WinState = { wins = 1, stage = 3 }
		GameLogic.applyWin(input, 0)
		expect(input.wins).toBe(1)
		expect(input.stage).toBe(3)
	end)
end)

describe("sanitizeSaveData", function()
	it("passes through valid data", function()
		local data = GameLogic.sanitizeSaveData({ Wins = 5, Speed = 42 })
		expect(data.Wins).toBe(5)
		expect(data.Speed).toBe(42)
	end)
	it("defaults missing or non-table data", function()
		for _, raw in { nil, 7, "x", {} } do
			local data = GameLogic.sanitizeSaveData(raw)
			expect(data.Wins).toBe(0)
			expect(data.Speed).toBe(DEFAULT.baseSpeed)
		end
	end)
	it("floors, clamps and rejects garbage", function()
		local data = GameLogic.sanitizeSaveData({ Wins = 3.7, Speed = 1e9 })
		expect(data.Wins).toBe(3)
		expect(data.Speed).toBe(DEFAULT.maxSpeed)
		data = GameLogic.sanitizeSaveData({ Wins = -4, Speed = 0 / 0 })
		expect(data.Wins).toBe(0)
		expect(data.Speed).toBe(DEFAULT.baseSpeed)
		data = GameLogic.sanitizeSaveData({ Wins = math.huge, Speed = "200" })
		expect(data.Wins).toBe(0)
		expect(data.Speed).toBe(DEFAULT.baseSpeed)
	end)
end)

describe("GameLogic module", function()
	it("is frozen", function()
		expect(table.isfrozen(GameLogic)).toBeTruthy()
		expect(table.isfrozen(DEFAULT)).toBeTruthy()
	end)
end)

describe("course beatability", function()
	local StageGenerator = require("../src/shared/StageGenerator")
	local Constants = require("../src/shared/Constants")

	it("can reach the speed the widest gap needs", function()
		local needed = StageGenerator.requiredSpeedForGap(StageGenerator.ABSOLUTE_MAX_GAP, Constants.JUMP_POWER)
		expect(DEFAULT.maxSpeed >= needed).toBeTruthy()
		local speed, t, seconds = DEFAULT.baseSpeed, 0, 0
		while speed < needed do
			speed, t = GameLogic.tickSpeed(speed, t, 1, true)
			seconds += 1
		end
		expect(seconds <= 15).toBeTruthy()
	end)
	it("builds a course with stageCount in the generator's range", function()
		expect(Constants.STAGE_COUNT >= StageGenerator.MIN_STAGES).toBeTruthy()
		expect(Constants.STAGE_COUNT <= StageGenerator.MAX_STAGES).toBeTruthy()
		expect(#StageGenerator.layout({ stageCount = Constants.STAGE_COUNT }) > 0).toBeTruthy()
	end)
	it("never drops a kept speed below baseSpeed on respawn", function()
		expect(GameLogic.clampSpeed(0)).toBe(DEFAULT.baseSpeed)
		expect(GameLogic.clampSpeed(42)).toBe(42)
	end)
end)
