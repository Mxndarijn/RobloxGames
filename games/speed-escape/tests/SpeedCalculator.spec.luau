--!strict
local SpeedCalculator = require("../src/shared/SpeedCalculator")
local TestRunner = require("./TestRunner")

local describe, it, expect = TestRunner.describe, TestRunner.it, TestRunner.expect
local DEFAULT = SpeedCalculator.DEFAULT_CONFIG

describe("getMultiplier", function()
	it("is 1 with no rebirths", function()
		expect(SpeedCalculator.getMultiplier(0)).toBe(1)
	end)
	it("grows linearly per rebirth", function()
		expect(SpeedCalculator.getMultiplier(1)).toBe(1 + DEFAULT.rebirthMultiplierStep)
		expect(SpeedCalculator.getMultiplier(4)).toBe(1 + 4 * DEFAULT.rebirthMultiplierStep)
	end)
	it("treats negative and NaN rebirths as 0", function()
		expect(SpeedCalculator.getMultiplier(-3)).toBe(1)
		expect(SpeedCalculator.getMultiplier(0 / 0)).toBe(1)
	end)
	it("respects a custom config", function()
		expect(SpeedCalculator.getMultiplier(2, { rebirthMultiplierStep = 1 })).toBe(3)
	end)
end)

describe("getSpeed", function()
	it("returns base speed at 0 steps", function()
		expect(SpeedCalculator.getSpeed(0)).toBe(DEFAULT.baseSpeed)
	end)
	it("adds speedPerStep per step", function()
		expect(SpeedCalculator.getSpeed(100)).toBeCloseTo(DEFAULT.baseSpeed + 100 * DEFAULT.speedPerStep)
	end)
	it("applies the rebirth multiplier", function()
		local expected = DEFAULT.baseSpeed + 100 * DEFAULT.speedPerStep * SpeedCalculator.getMultiplier(2)
		expect(SpeedCalculator.getSpeed(100, 2)).toBeCloseTo(expected)
	end)
	it("is capped at maxSpeed", function()
		expect(SpeedCalculator.getSpeed(1e12, 10)).toBe(DEFAULT.maxSpeed)
	end)
	it("floors fractional and clamps negative steps", function()
		expect(SpeedCalculator.getSpeed(10.9)).toBeCloseTo(SpeedCalculator.getSpeed(10))
		expect(SpeedCalculator.getSpeed(-50)).toBe(DEFAULT.baseSpeed)
	end)
end)

describe("getStepsForSpeed", function()
	it("returns 0 for speeds at or below base", function()
		expect(SpeedCalculator.getStepsForSpeed(DEFAULT.baseSpeed)).toBe(0)
		expect(SpeedCalculator.getStepsForSpeed(1)).toBe(0)
	end)
	it("returns nil above maxSpeed", function()
		expect(SpeedCalculator.getStepsForSpeed(DEFAULT.maxSpeed + 1)).toBeNil()
	end)
	it("is the inverse of getSpeed", function()
		for _, rebirths in { 0, 1, 3 } do
			local steps = SpeedCalculator.getStepsForSpeed(50, rebirths) :: number
			expect(SpeedCalculator.getSpeed(steps, rebirths) >= 50).toBeTruthy()
			expect(SpeedCalculator.getSpeed(steps - 1, rebirths) < 50).toBeTruthy()
		end
	end)
	it("returns nil when steps give no speed", function()
		expect(SpeedCalculator.getStepsForSpeed(20, 0, { speedPerStep = 0 })).toBeNil()
	end)
end)

describe("getRebirthCost", function()
	it("starts at rebirthBaseCost", function()
		expect(SpeedCalculator.getRebirthCost(0)).toBe(DEFAULT.rebirthBaseCost)
	end)
	it("grows geometrically", function()
		expect(SpeedCalculator.getRebirthCost(1)).toBe(math.floor(DEFAULT.rebirthBaseCost * DEFAULT.rebirthCostGrowth))
		expect(SpeedCalculator.getRebirthCost(3)).toBe(
			math.floor(DEFAULT.rebirthBaseCost * DEFAULT.rebirthCostGrowth ^ 3)
		)
	end)
	it("is strictly increasing", function()
		for i = 0, 10 do
			expect(SpeedCalculator.getRebirthCost(i + 1) > SpeedCalculator.getRebirthCost(i)).toBeTruthy()
		end
	end)
	it("returns whole numbers", function()
		local cost = SpeedCalculator.getRebirthCost(5)
		expect(cost).toBe(math.floor(cost))
	end)
end)

describe("canRebirth", function()
	it("is false below cost", function()
		expect(SpeedCalculator.canRebirth(DEFAULT.rebirthBaseCost - 1, 0)).toBeFalsy()
	end)
	it("is true at exactly the cost", function()
		expect(SpeedCalculator.canRebirth(DEFAULT.rebirthBaseCost, 0)).toBeTruthy()
	end)
	it("uses the cost for the current rebirth count", function()
		local cost1 = SpeedCalculator.getRebirthCost(1)
		expect(SpeedCalculator.canRebirth(cost1 - 1, 1)).toBeFalsy()
		expect(SpeedCalculator.canRebirth(cost1, 1)).toBeTruthy()
	end)
end)

describe("getRebirthProgress", function()
	it("is 0 with no steps, 0.5 halfway, clamped to 1", function()
		expect(SpeedCalculator.getRebirthProgress(0, 0)).toBe(0)
		expect(SpeedCalculator.getRebirthProgress(DEFAULT.rebirthBaseCost / 2, 0)).toBeCloseTo(0.5)
		expect(SpeedCalculator.getRebirthProgress(DEFAULT.rebirthBaseCost * 10, 0)).toBe(1)
	end)
end)

describe("applyRebirth", function()
	it("resets steps and increments rebirths when affordable", function()
		local ok, steps, rebirths = SpeedCalculator.applyRebirth(DEFAULT.rebirthBaseCost + 5, 0)
		expect(ok).toBe(true)
		expect(steps).toBe(0)
		expect(rebirths).toBe(1)
	end)
	it("leaves state unchanged when not affordable", function()
		local ok, steps, rebirths = SpeedCalculator.applyRebirth(10, 2)
		expect(ok).toBe(false)
		expect(steps).toBe(10)
		expect(rebirths).toBe(2)
	end)
end)

describe("stepsFromDistance", function()
	it("floors distance / studsPerStep", function()
		expect(SpeedCalculator.stepsFromDistance(10, 4)).toBe(2)
		expect(SpeedCalculator.stepsFromDistance(3.9, 4)).toBe(0)
	end)
	it("returns 0 for non-positive studsPerStep", function()
		expect(SpeedCalculator.stepsFromDistance(100, 0)).toBe(0)
	end)
end)

describe("formatNumber", function()
	it("formats small numbers verbatim", function()
		expect(SpeedCalculator.formatNumber(0)).toBe("0")
		expect(SpeedCalculator.formatNumber(999)).toBe("999")
	end)
	it("abbreviates with suffixes", function()
		expect(SpeedCalculator.formatNumber(1000)).toBe("1K")
		expect(SpeedCalculator.formatNumber(1500)).toBe("1.5K")
		expect(SpeedCalculator.formatNumber(2_000_000)).toBe("2M")
		expect(SpeedCalculator.formatNumber(3_450_000_000)).toBe("3.4B")
	end)
	it("handles negatives and NaN", function()
		expect(SpeedCalculator.formatNumber(-1500)).toBe("-1.5K")
		expect(SpeedCalculator.formatNumber(0 / 0)).toBe("0")
	end)
end)

describe("DEFAULT_CONFIG", function()
	it("is frozen", function()
		expect(function()
			(SpeedCalculator.DEFAULT_CONFIG :: any).baseSpeed = 0
		end).toThrow()
	end)
end)
