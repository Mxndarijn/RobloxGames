{
  "_doc": "Maps changed repo paths to the Studio shots a PARTIAL run captures (watcher.plan_run). {G} = games/steal-a-slime. Order of checks per path: full -> ignore -> first matching rule -> unmatched = FULL. Rules go specific -> broad. Shot selectors: shot-id globs (case-insensitive), kinds (ui|world), keys (shot fields). See README 'Full vs partial runs'.",
  "vars": {"G": "games/steal-a-slime"},
  "smoke": ["00-v30-c2-first-frame-pc", "01-hud-menus", "01b-idle-hud", "03-shop-menu", "06-map-top"],
  "always_keys": ["runtime_parts_max", "mesh_slots_max"],
  "full": [
    "tools/pipeline/pc-watcher/**",
    "{G}/default.project.json", "{G}/wally.toml", "{G}/rokit.toml",
    "{G}/src/shared/Config.luau", "{G}/src/shared/Constants.luau", "{G}/src/shared/Types.luau",
    "{G}/src/shared/FeatureOverride.luau",
    "{G}/src/server/init.server.luau", "{G}/src/ui/init.client.luau", "{G}/src/visuals/client/init.client.luau",
    "{G}/src/ui/Layout.luau", "{G}/src/visuals/shared/WorldBuilder.luau", "{G}/src/visuals/shared/WorldLayout.luau"
  ],
  "ignore": [
    "**/*.md", "docs/**", ".github/**", "tools/pr-gate/**", "games/speed-escape/**",
    "{G}/tests/**", "{G}/docs/**", "{G}/tools/**", "{G}/scripts/**", "{G}/sheets/**",
    "{G}/animations/**", "{G}/src/visuals/tools/**",
    "{G}/selene.toml", "{G}/stylua.toml", "{G}/roblox.yml", "{G}/ui-perf-budget.json", "{G}/publish-response.json",
    "shared/modeling-kit/*", "shared/modeling-kit/models/**", "shared/modeling-kit/sheets/**",
    "shared/modeling-kit/lib/**", "shared/modeling-kit/tools/**", "shared/modeling-kit/examples/**",
    "shared/modeling-kit/kit/**"
  ],
  "rules": [
    {"name": "bug probes", "paths": ["tools/pipeline/pc-watcher/luau/bug*.luau", "tools/pipeline/pc-watcher/luau/rel_*.luau", "tools/pipeline/pc-watcher/shots/*bug*", "tools/pipeline/pc-watcher/shots/*rel-*"],
     "keys": ["bug_probe"], "shots": ["bug*", "rel-*"]},
    {"name": "shop UI", "paths": ["{G}/src/ui/Panels/Shop.luau", "{G}/src/ui/Panels/WorldShop.luau", "{G}/src/ui/WorldShopLogic.luau", "{G}/src/ui/ShopCatalog.luau"],
     "shots": ["*shop*"], "steps": ["devices"]},
    {"name": "dex", "paths": ["{G}/src/ui/Panels/Dex.luau", "{G}/src/ui/SlimeDex.luau", "{G}/src/ui/SlimePreview.luau"],
     "shots": ["*dex*"], "steps": ["devices"]},
    {"name": "rebirth", "paths": ["{G}/src/ui/Panels/Rebirth.luau"], "shots": ["*rebirth*"]},
    {"name": "goals / quests / daily", "paths": ["{G}/src/ui/Goals.luau", "{G}/src/ui/Panels/Goals.luau", "{G}/src/ui/Daily.luau", "{G}/src/ui/Panels/DailyPopup.luau"],
     "shots": ["*goals*", "*quest*", "*daily*", "*streak*"]},
    {"name": "codes", "paths": ["{G}/src/ui/Panels/Codes.luau"], "shots": ["*codes*"]},
    {"name": "merge", "paths": ["{G}/src/ui/Panels/Merge.luau", "{G}/src/**/MergeVat*.luau", "{G}/src/**/Vat*.luau"],
     "shots": ["*merge*", "*bug16*"]},
    {"name": "sound", "paths": ["{G}/src/ui/Panels/Sound.luau", "{G}/src/ui/AudioLogic.luau", "{G}/src/ui/SoundController.luau", "{G}/src/ui/Sounds.luau"],
     "shots": ["*sound*", "*audio*"]},
    {"name": "H1 HUD (bottom clusters, left column)",
     "paths": ["{G}/src/ui/Hud.luau", "{G}/src/ui/HudClusters.luau", "{G}/src/ui/Nav.luau", "{G}/src/ui/FriendBadge.luau",
               "{G}/src/ui/ModifierBadge.luau", "{G}/src/ui/RainTimer.luau", "{G}/src/ui/NextSpawn.luau", "{G}/src/ui/WeekendBadge.luau"],
     "shots": ["*hud*", "*chip*", "*banner*", "*weekend*", "*modifier*", "*admin-event*", "*friend*"], "steps": ["devices"]},
    {"name": "tutorial / hints / guide / toasts / banners",
     "paths": ["{G}/src/ui/Panels/TutorialOverlay.luau", "{G}/src/ui/Tutorial.luau", "{G}/src/ui/Hint*.luau", "{G}/src/ui/Panels/HintOverlay.luau",
               "{G}/src/ui/GuideTips.luau", "{G}/src/ui/Panels/Guide.luau", "{G}/src/ui/PopupQueue.luau", "{G}/src/ui/RareAnnounce.luau",
               "{G}/src/ui/ToastQueue.luau", "{G}/src/ui/Toasts.luau"],
     "shots": ["*hud*", "*toast*", "*banner*", "*guide*", "*tutorial*"], "steps": ["devices"]},
    {"name": "events board", "paths": ["{G}/src/ui/EventsBoard.luau"], "shots": ["*events-board*"]},
    {"name": "item icons", "paths": ["{G}/src/ui/Icons.luau", "{G}/src/ui/ItemIcon*.luau"], "shots": ["*item-icons*", "*badge*"]},
    {"name": "slime life / motion",
     "paths": ["{G}/src/ui/SlimeLife*.luau", "{G}/src/ui/SlimeMotor.luau", "{G}/src/ui/SlimeLod.luau", "{G}/src/ui/SlimeAnim.luau",
               "{G}/src/visuals/shared/SlimeRig.luau", "{G}/src/visuals/client/PetRig.luau", "{G}/src/visuals/client/FollowPets.luau"],
     "keys": ["motion"], "shots": ["*motion*"]},
    {"name": "steal alert", "paths": ["{G}/src/ui/StealAlertFx.luau", "{G}/src/ui/StealAlertLayout.luau"], "shots": ["*steal-alert*"]},
    {"name": "weather / night",
     "paths": ["{G}/src/**/Weather*.luau", "{G}/src/visuals/client/SnowGround.luau", "{G}/src/visuals/shared/SnowCover.luau",
               "{G}/src/visuals/client/NightSky.luau", "{G}/src/visuals/shared/NightLook.luau", "{G}/src/shared/DayNight.luau"],
     "keys": ["weather", "clock"], "shots": ["*weather*", "*snow*", "*night*"]},
    {"name": "ground terrain (dirt path, pastel grass, plaza sand)", "paths": ["{G}/src/**/GroundTerrain*.luau", "shared/modeling-kit/out/ground/**"],
     "shots": ["*ground*", "*path*", "*slide-exit*", "*curb*", "*snow*"]},
    {"name": "border / terrain", "paths": ["{G}/src/**/BorderTerrain*.luau", "{G}/src/visuals/shared/WorldBorder.luau"], "shots": ["*border*", "*bug14*", "*bug15*"]},
    {"name": "minimap", "paths": ["{G}/src/visuals/shared/MinimapData.luau", "{G}/src/**/Minimap*.luau"], "shots": ["*minimap*"]},
    {"name": "fountain / slide",
     "paths": ["{G}/src/**/Fountain*.luau", "{G}/src/shared/SlideColliders.luau", "{G}/src/server/StackGuard.luau"],
     "keys": ["fountain_walk", "slide_walk"], "shots": ["*fountain*", "*slide*", "*rel-stackguard*", "*bug09*", "*bug10*", "*bug11*", "*bug12*"]},
    {"name": "lane / paths", "paths": ["{G}/src/shared/ParadeLane.luau", "{G}/src/server/ParadeView.luau", "{G}/src/server/Spawner.luau"],
     "keys": ["ring_slimes", "wild_pace"], "shots": ["*ring-slimes*", "*wild-pace*", "*path*", "*slide-exit*", "*curb*", "*bug01*", "*bug04*", "*bug05*", "*bug06*", "*bug07*", "*bug13*"]},
    {"name": "habitats", "paths": ["{G}/src/**/Habitat*.luau"], "keys": ["habitat"], "shots": ["*habitat*"]},
    {"name": "plots / pads / signs",
     "paths": ["{G}/src/server/PlotSigns.luau", "{G}/src/server/PlotLockGuard.luau", "{G}/src/shared/PadStyle.luau", "{G}/src/visuals/shared/PlotDecor.luau",
               "{G}/src/visuals/client/PlotVisuals.luau", "{G}/src/shared/PlotSkins.luau"],
     "shots": ["*pad*", "*plot*", "*sign*", "*mailbox*", "*bug02*", "*bug03*", "*bug08*", "*bug12*"]},
    {"name": "podium / top earners", "paths": ["{G}/src/**/Podium*.luau", "{G}/src/server/Leaderboard.luau"],
     "shots": ["*podium*", "*topearners*", "*bug02*"]},
    {"name": "props / meshes",
     "paths": ["{G}/src/server/WorldProps.luau", "{G}/src/server/WorldView.luau", "{G}/src/server/Scene.luau", "{G}/src/server/MeshSwap.luau",
               "{G}/src/shared/MeshAssets.luau", "{G}/src/visuals/shared/Props.luau", "{G}/src/visuals/shared/RanchProps.luau",
               "{G}/src/visuals/shared/ModelFactory.luau", "{G}/src/visuals/shared/Meadow.luau", "{G}/src/visuals/shared/PropClearance.luau",
               "{G}/world/**", "shared/modeling-kit/out/**"],
     "kinds": ["world"]},
    {"name": "ui (broad)", "paths": ["{G}/src/ui/**"], "kinds": ["ui"], "steps": ["devices"]},
    {"name": "visuals (broad)", "paths": ["{G}/src/visuals/**"], "kinds": ["world"]}
  ]
}
