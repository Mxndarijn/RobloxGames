--!strict
local IdleRejoin = require("../../src/idle/IdleRejoin")
local T = require("../../testing/TestRunner")
local describe, it, expect = T.describe, T.it, T.expect

describe("IdleRejoin", function()
	it("waits until the player has been idle for rejoinAfter seconds", function()
		local tracker = IdleRejoin.new({ rejoinAfter = 100 })
		expect(tracker:idled(1, 99, 0)).toBe(false)
		expect(tracker:idled(1, 100, 1)).toBe(true)
	end)

	it("defaults to 18 minutes, before Roblox's 20-minute kick", function()
		local tracker = IdleRejoin.new()
		expect(tracker:idled(1, 17 * 60, 0)).toBe(false)
		expect(tracker:idled(1, 18 * 60, 0)).toBe(true)
	end)

	it("retries only after retryAfter seconds", function()
		local tracker = IdleRejoin.new({ rejoinAfter = 100, retryAfter = 30 })
		expect(tracker:idled(1, 100, 0)).toBe(true)
		expect(tracker:idled(1, 110, 10)).toBe(false)
		expect(tracker:idled(1, 130, 30)).toBe(true)
	end)

	it("stops after maxTries attempts", function()
		local tracker = IdleRejoin.new({ rejoinAfter = 100, retryAfter = 0, maxTries = 2 })
		expect(tracker:idled(1, 100, 0)).toBe(true)
		expect(tracker:idled(1, 100, 1)).toBe(true)
		expect(tracker:idled(1, 100, 2)).toBe(false)
	end)

	it("starts over after forget", function()
		local tracker = IdleRejoin.new({ rejoinAfter = 100, retryAfter = 30, maxTries = 1 })
		expect(tracker:idled(1, 100, 0)).toBe(true)
		expect(tracker:idled(1, 200, 50)).toBe(false)
		tracker:forget(1)
		expect(tracker:idled(1, 100, 51)).toBe(true)
	end)

	it("starts over when the player was active again", function()
		local tracker = IdleRejoin.new({ rejoinAfter = 100, maxTries = 1 })
		expect(tracker:idled(1, 100, 0)).toBe(true)
		expect(tracker:idled(1, 120, 0)).toBe(false)
		expect(tracker:idled(1, 30, 200)).toBe(false)
		expect(tracker:idled(1, 100, 270)).toBe(true)
	end)

	it("keeps players apart", function()
		local tracker = IdleRejoin.new({ rejoinAfter = 100, maxTries = 1 })
		expect(tracker:idled(1, 100, 0)).toBe(true)
		expect(tracker:idled(2, 100, 0)).toBe(true)
		expect(tracker:idled(1, 100, 99)).toBe(false)
	end)

	it("refuses bad options", function()
		expect(function()
			IdleRejoin.new({ rejoinAfter = 0 })
		end).toThrow()
		expect(function()
			IdleRejoin.new({ maxTries = 0 })
		end).toThrow()
	end)
end)
