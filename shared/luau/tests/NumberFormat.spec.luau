--!strict
local NumberFormat = require("../src/core/NumberFormat")
local T = require("../testing/TestRunner")
local describe, it, expect = T.describe, T.it, T.expect

describe("NumberFormat.short", function()
	it("keeps numbers below 1000 whole", function()
		expect(NumberFormat.short(0)).toBe("0")
		expect(NumberFormat.short(999)).toBe("999")
		expect(NumberFormat.short(12.9)).toBe("12")
	end)

	it("uses three significant digits with a suffix", function()
		expect(NumberFormat.short(1000)).toBe("1K")
		expect(NumberFormat.short(1250)).toBe("1.25K")
		expect(NumberFormat.short(12500)).toBe("12.5K")
		expect(NumberFormat.short(125000)).toBe("125K")
		expect(NumberFormat.short(3.4e6)).toBe("3.4M")
		expect(NumberFormat.short(1.2e9)).toBe("1.2B")
		expect(NumberFormat.short(1.25e12)).toBe("1.25T")
	end)

	it("truncates instead of rounding up past a suffix", function()
		expect(NumberFormat.short(999999)).toBe("999K")
		expect(NumberFormat.short(1999)).toBe("1.99K")
	end)

	it("keeps the sign of negatives", function()
		expect(NumberFormat.short(-1250)).toBe("-1.25K")
		expect(NumberFormat.short(-40)).toBe("-40")
	end)

	it("does not show -0 for small negatives", function()
		expect(NumberFormat.short(-0.5)).toBe("0")
	end)

	it("gives 0 for non-finite and non-number values", function()
		expect(NumberFormat.short(0 / 0)).toBe("0")
		expect(NumberFormat.short(math.huge)).toBe("0")
		expect(NumberFormat.short(-math.huge)).toBe("0")
		expect(NumberFormat.short(("x" :: any) :: number)).toBe("0")
	end)

	it("stops at the largest suffix", function()
		expect(NumberFormat.short(1e40)).toBe("10000000Dc")
	end)
end)

describe("NumberFormat.cash", function()
	it("prefixes with $ by default", function()
		expect(NumberFormat.cash(1250)).toBe("$1.25K")
		expect(NumberFormat.cash(5)).toBe("$5")
	end)

	it("puts the minus before the prefix", function()
		expect(NumberFormat.cash(-40)).toBe("-$40")
	end)

	it("takes a custom prefix", function()
		expect(NumberFormat.cash(3.4e6, "G ")).toBe("G 3.4M")
		expect(NumberFormat.cash(-2, "")).toBe("-2")
	end)
end)

describe("NumberFormat.duration", function()
	it("shows seconds under a minute", function()
		expect(NumberFormat.duration(0)).toBe("0s")
		expect(NumberFormat.duration(42)).toBe("42s")
	end)

	it("shows minutes and padded seconds", function()
		expect(NumberFormat.duration(60)).toBe("1m 00s")
		expect(NumberFormat.duration(245)).toBe("4m 05s")
	end)

	it("shows hours and padded minutes", function()
		expect(NumberFormat.duration(3900)).toBe("1h 05m")
		expect(NumberFormat.duration(3600 * 23 + 59 * 60 + 59)).toBe("23h 59m")
	end)

	it("shows days and padded hours", function()
		expect(NumberFormat.duration(93600)).toBe("1d 02h")
	end)

	it("rounds partial seconds up and never goes negative", function()
		expect(NumberFormat.duration(0.2)).toBe("1s")
		expect(NumberFormat.duration(-5)).toBe("0s")
		expect(NumberFormat.duration(0 / 0)).toBe("0s")
	end)
end)

describe("NumberFormat.clock", function()
	it("formats m:ss and h:mm:ss", function()
		expect(NumberFormat.clock(65)).toBe("1:05")
		expect(NumberFormat.clock(3725)).toBe("1:02:05")
		expect(NumberFormat.clock(0)).toBe("0:00")
	end)

	it("rounds partial seconds up", function()
		expect(NumberFormat.clock(0.1)).toBe("0:01")
	end)
end)

describe("NumberFormat.remaining and progress", function()
	it("remaining is never below 0 and 0 for bad input", function()
		expect(NumberFormat.remaining(110, 100)).toBe(10)
		expect(NumberFormat.remaining(90, 100)).toBe(0)
		expect(NumberFormat.remaining(nil, 100)).toBe(0)
	end)

	it("progress is clamped to 0..1 and an empty span is done", function()
		expect(NumberFormat.progress(0, 10, 5)).toBe(0.5)
		expect(NumberFormat.progress(0, 10, -1)).toBe(0)
		expect(NumberFormat.progress(0, 10, 20)).toBe(1)
		expect(NumberFormat.progress(5, 5, 0)).toBe(1)
	end)
end)
